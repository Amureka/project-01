  if(!ST.edit)startEdit(true);const no=nextNo();conds.forEach(x=>ST.rows.push({no,op:ST.ruleOp,pr,col:x.col,o:x.o,v:x.v}));ST.lastOp=ST.ruleOp;ST.newNos.add(no);ST.rulePrManual=true;ST.ruleNo=String(no);ST.hlNo=no;
