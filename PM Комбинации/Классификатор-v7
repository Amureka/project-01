.sinput::before{content:"";position:absolute;left:11px;top:50%;transform:translateY(-50%);width:14px;height:14px;background:var(--colorTextTertiary);-webkit-mask:var(--ic-search) no-repeat center/contain;mask:var(--ic-search) no-repeat center/contain;pointer-events:none;z-index:1}
