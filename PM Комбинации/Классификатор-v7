.dr-handle:hover{background:var(--colorPrimaryBgHover)}
.oppanel{background:var(--colorBgElevated);border-left:1px solid var(--colorBorderSecondary);box-shadow:-6px 0 16px 0 rgba(0,0,0,.08),-3px 0 6px -4px rgba(0,0,0,.12),-9px 0 28px 8px rgba(0,0,0,.05)}
.op-grip{border-color:var(--colorBorder);background:var(--colorBgContainer);color:var(--colorTextTertiary)}
.op-collapse,.op-title a:hover{color:var(--colorPrimary)}
.op-title,.op-title .op-ic{color:var(--colorText)}
.op-title .op-ic,.op-title a{color:var(--colorIcon)}
.opv{background:var(--colorFillAlter-solid);border:1px solid var(--colorBorderSecondary);border-radius:var(--borderRadius);color:var(--colorText)}
