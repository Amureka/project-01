function opOptions(val){const c=ST.c,ids=clsOps(c),mine=OPS.filter(o=>ids.includes(o.id)),rest=[];const o=x=>`<option value="${x.id}" ${x.id===val?'selected':''}>${esc(x.name)}</option>`;return `<optgroup label="Операции классификатора">${mine.map(o).join('')}</optgroup>${rest.length?`<optgroup label="Другие операции процессов классификатора">${rest.map(o).join('')}</optgroup>`:''}`;}
function checkFlags(rows){const rs=ruleSets(rows);const f={empty:new Set(),conf:new Map(),shadow:new Map(),skip:new Set()};
  const done=no=>rows.filter(r=>r.no===no).every(r=>(r.op||r.opText)&&r.col&&r.o&&(String(r.v).trim()||['пусто','не пусто'].includes(r.o)));
  rs.forEach(r=>{if(!done(r.no))f.skip.add(r.no);else if(r.pr===''||r.pr==null)f.empty.add(r.no);});
  const ok=rs.filter(r=>!f.skip.has(r.no)&&!f.empty.has(r.no));
  ok.forEach(a=>ok.forEach(b=>{if(a.no>=b.no||a.op===b.op||+a.pr!==+b.pr)return;const eq=a.keys.size===b.keys.size&&[...a.keys].every(k=>b.keys.has(k));if(eq){f.conf.set(a.no,b.no);f.conf.set(b.no,a.no);}}));
  const valid=rows.filter(r=>!f.skip.has(r.no));const won=new Set(),hit=new Set();
  SAMPLE.forEach(row=>{const e=evalRow(row,valid);e.all.forEach(n=>hit.add(n));if(e.win)won.add(e.win);if(e.conf)e.top.forEach(n=>{const o=e.top.find(m=>m!==n);if(o)f.conf.set(n,o);});});
  hit.forEach(n=>{if(!won.has(n)&&!f.conf.has(n)&&!f.shadow.has(n)){const any=SAMPLE.map(row=>evalRow(row,valid)).find(e=>e.all.includes(n)&&e.win);if(any)f.shadow.set(n,any.win);}});
  return f;}
function prCell(no,pr,first,ed,i,FL){let cls='num'+(first?'':' rep'),tip='';
  if(FL&&first){if(FL.empty.has(no)){cls+=' prerr';tip='Приоритет не задан';}else if(FL.conf.has(no)){cls+=' prerr';tip=`Такой же приоритет у правила ${FL.conf.get(no)} с другой операцией - строки, которые ловят оба, не разнести`;}else if(FL.shadow.has(no)){cls+=' prwarn';tip=`Строки правила забирает правило ${FL.shadow.get(no)} с более высоким приоритетом`;}}
  let h=cl(i,'pr',pr,cls,ed);if(FL&&first&&FL.empty.has(no)&&!(ST.ec&&ST.ec.i===i&&ST.ec.f==='pr'))h=h.replace(/><\/td>$/,'>не задан</td>');return tip?h.replace('<td ',`<td title="${esc(tip)}" `):h;}
function gridHtml(rows,ed){GRID_ALERT=null;const idx=rows.map((r,i)=>i).filter(i=>passF(rows[i])).sort((a,b)=>(rows[a].no-rows[b].no)||(a-b));const seen=new Set();
  const FL=ST.checked&&okCheck(ST.c)&&!ST.checking&&rows===ST.rows?checkFlags(rows):null;
  let h=`<thead><tr><th class="num">№</th><th>Операция</th><th class="num">Приоритет<span class="ihelp" data-tip="${esc(PR_TIP)}"></span></th><th>Колонка</th><th>Оператор</th><th>Значения</th><th class="ic"></th></tr></thead><tbody>`;
  idx.forEach(i=>{const r=rows[i],first=!seen.has(r.no);seen.add(r.no);const err=ST.errNos.has(r.no);const skip=FL&&FL.skip.has(r.no);
    h+=`<tr class="r${first?' first':''}${ST.newNos.has(r.no)?' newrule':''}${ST.hlNo===r.no?' selrule':''}">${cl(i,'no',r.no,'num'+(first?'':' rep')+(skip&&first?' prerr':''),ed).replace('<td ',skip&&first?'<td title="Правило не проверено: заполнены не все поля" ':'<td ')}${r.op&&OPS.some(o=>o.id===r.op)&&!clsOps(ST.c).includes(r.op)&&!(ed&&ST.ec&&ST.ec.i===i&&ST.ec.f==='op')?`<td class="c dd err" data-tip="Операции нет в процессах классификатора - выберите другую или проставьте ей процесс ARIS в каталоге" ${ed?`onclick="ST.ec={i:${i},f:'op'};renderRules()"`:''}>${esc(opName(r.op))}</td>`:r.op&&!OPS.some(o=>o.id===r.op)&&!(ed&&ST.ec&&ST.ec.i===i&&ST.ec.f==='op')?`<td class="c dd err" data-tip="Операция удалена из каталога - выберите другую" ${ed?`onclick="ST.ec={i:${i},f:'op'};renderRules()"`:''}>${esc(opName(r.op))}</td>`:r.opText&&!r.op&&!(ed&&ST.ec&&ST.ec.i===i&&ST.ec.f==='op')?`<td class="c dd err" data-tip="Операции нет в каталоге - выберите операцию или добавьте её в каталог" ${ed?`onclick="ST.ec={i:${i},f:'op'};renderRules()"`:''}>${esc(r.opText)}</td>`:cl(i,'op',r.op,'dd '+(first?'':'rep')+((err||skip)&&!r.op?' err':''),ed)}${prCell(r.no,r.pr,first,ed,i,FL)}${cl(i,'col',r.col,'dd'+((err||skip)&&!r.col?' err':''),ed)}${cl(i,'o',r.o,'dd'+((err||skip)&&!r.o?' err':''),ed)}${cl(i,'v',r.v,(err||skip)&&!String(r.v).trim()&&!['пусто','не пусто'].includes(r.o)?'err':(err&&r.bad?'err':''),ed)}<td class="ic">${first?`<a title="Показать строки правила в датасете" onclick="event.stopPropagation();loadRule(${r.no})"><svg viewBox="0 0 1024 1024" width="15" height="15" fill="currentColor" focusable="false"><path d="M880.1 154H143.9c-24.5 0-39.8 26.7-27.5 48L349 597.4V838c0 17.7 14.2 32 31.8 32h262.4c17.6 0 31.8-14.3 31.8-32V597.4L907.7 202c12.2-21.3-3.1-48-27.6-48zM603.4 798H420.6V642h182.9v156zm9.6-236.6l-9.5 16.6h-183l-9.5-16.6L212.7 226h598.6L613 561.4z"/></svg></a>`:''}${ed?`<a title="Удалить строку" onclick="event.stopPropagation();delRow(${i})">${ICON.del}</a>`:''}</td></tr>`;});
  if(ed)h+='<tr class="trail" onclick="addRow()"><td colspan="7">+ Нажмите, чтобы добавить строку</td></tr>';
  if(FL&&(FL.empty.size||FL.conf.size||FL.skip.size)){const m=[];if(FL.skip.size)m.push(`заполнены не все поля в правилах ${[...FL.skip].join(', ')}`);if(FL.empty.size)m.push(`не задан приоритет в правилах ${[...FL.empty].join(', ')}`);if(FL.conf.size)m.push(`одинаковый приоритет при разных операциях в правилах ${[...new Set(FL.conf.keys())].sort((x,y)=>x-y).join(', ')}`);GRID_ALERT=rows===ST.rows?`<div class="alert alert-error">${NF_IC.warning}<span>По итогам проверки: ${m.join('; ')}. До исправления утвердить нельзя.</span></div>`:null;}
  return h+'</tbody>';}
function cl(i,f,val,cls,ed){if(ed&&ST.ec&&ST.ec.i===i&&ST.ec.f===f){const r=ST.rows[i];
    if(f==='op')return `<td class="c editing"><span class="sizer">${esc(f==='op'?opName(val):val)}</span><select class="editor" onchange="commitCell(${i},'op',+this.value||'')" onblur="ST.ec=null;renderRules()">${opOptions(val)}</select></td>`;
    if(f==='col'||f==='o'){const list=f==='col'?COLS:opsFor(r.col);return `<td class="c editing"><span class="sizer">${esc(f==='op'?opName(val):val)}</span><select class="editor" onchange="commitCell(${i},'${f}',this.value)" onblur="ST.ec=null;renderRules()">${list.map(x=>`<option ${x===val?'selected':''}>${x}</option>`).join('')}</select></td>`;}
    return `<td class="c editing"><span class="sizer">${esc(f==='op'?opName(val):val)}</span><input class="editor" type="${f==='no'||f==='pr'?'number':'text'}" value="${esc(val)}" onkeydown="if(event.key==='Enter')this.blur();if(event.key==='Escape'){ST.ec=null;renderRules();}" onblur="commitCell(${i},'${f}',this.value)"></td>`;}
  return `<td class="c ${cls}" ${ed?`onclick="ST.ec={i:${i},f:'${f}'};renderRules()"`:''}>${f==='op'?esc(opName(val)):esc(val)}</td>`;}
function commitCell(i,f,v){if(!ST.ec)return;const r=ST.rows[i];if(f==='no')v=+v||r.no;else if(f==='pr')v=+v||'';
  if(f==='op'||f==='pr')ST.rows.forEach(x=>{if(x.no===r.no){x[f]=v;if(f==='op'&&v)delete x.opText;}});else if(f==='no'){const head=ST.rows.find((x,k)=>k!==i&&x.no===v);r.no=v;if(head){r.op=head.op;r.pr=head.pr;}}else r[f]=v;
  if(f==='col'&&!opsFor(v).includes(r.o))r.o='';ST.ec=null;renderRules();}
function addRow(){ST.rows.push({no:nextNo(),op:ST.lastOp||'',pr:'',col:'',o:'',v:''});ST.ec={i:ST.rows.length-1,f:'op'};renderRules();}
function delRow(i){ST.rows.splice(i,1);ST.ec=null;renderRules();}
const dre=/^\d{2}\.\d{2}\.\d{4}( \d{2}:\d{2}(:\d{2})?)?$/;
function saveEdit(){linkOps(ST.rows);RULES[ST.c.id]=clone(ST.rows.map(({bad,...r})=>r));ST.c.upd=TODAY;ST.c.approved=false;if(ST.checked){ST.stale=true;ST.c.stale=true;}ST.edit=false;ST.ec=null;ST.newNos=new Set();ST.errNos=new Set();renderCard();toast(ST.checked?'Черновик сохранён. Правила изменились - проверьте классификатор снова':'Черновик сохранён');}
function approveProblems(){const rows=ST.rows,f=checkFlags(rows),p=[];ST.errNos=new Set();
  const tx=[...new Set(rows.filter(r=>r.opText&&!r.op).map(r=>r.no))];if(tx.length)p.push(`операции нет в каталоге в правилах ${tx.join(', ')}`);
  const dl=[...new Set(rows.filter(r=>r.op&&!OPS.some(o=>o.id===r.op)).map(r=>r.no))];if(dl.length)p.push(`операция удалена из каталога в правилах ${dl.join(', ')}`);
  const ids=clsOps(ST.c),outp=[...new Set(rows.filter(r=>r.op&&OPS.some(o=>o.id===r.op)&&!ids.includes(r.op)).map(r=>r.no))];if(outp.length)p.push(`операции нет в процессах классификатора в правилах ${outp.join(', ')}`);
  rows.forEach(r=>{r.bad=false;const t=CT[r.col];const vs=splitVals(r.v);if(t&&t!=='string'&&!['пусто','не пусто'].includes(r.o)&&vs.length&&(!vs.every(x=>dre.test(x)))){r.bad=true;ST.errNos.add(r.no);}});
  if(f.skip.size){p.push(`заполнены не все поля в правилах ${[...f.skip].join(', ')}`);f.skip.forEach(n=>ST.errNos.add(n));}
  if(f.empty.size)p.push(`не задан приоритет в правилах ${[...f.empty].join(', ')}`);
  if(f.conf.size)p.push(`одинаковый приоритет при разных операциях в правилах ${[...new Set(f.conf.keys())].join(', ')}`);
  if(rows.some(r=>r.bad))p.push('даты - в виде ДД.ММ.ГГГГ или ДД.ММ.ГГГГ ЧЧ:ММ');return p;}

const PR_TIP='<p>Приоритет решает, какое правило сработает, если строка в датасете подходит под несколько правил с разными операциями. В таком сценарии будет использоваться правило с большим числом приоритета.</p>';
function tipShow(el){const t=$('#tip');t.innerHTML=el.dataset.tip;t.classList.remove('below');t.classList.add('on');const r=el.getBoundingClientRect(),W=Math.min(380,window.innerWidth-16);t.style.maxWidth=W+'px';t.style.left='0px';t.style.top='0px';const w=t.offsetWidth,h=t.offsetHeight;let x=r.left+r.width/2-w/2;x=Math.max(8,Math.min(x,window.innerWidth-8-w));let y=r.top-h-10;if(y<8){y=r.bottom+10;t.classList.add('below');}t.style.left=x+'px';t.style.top=y+'px';t.style.setProperty('--ax',Math.max(12,Math.min(w-12,r.left+r.width/2-x))+'px');}
function tipHide(){$('#tip').classList.remove('on');}
document.addEventListener('mouseover',e=>{const el=e.target.closest&&e.target.closest('[data-tip]');if(el)tipShow(el);});
document.addEventListener('mouseout',e=>{const el=e.target.closest&&e.target.closest('[data-tip]');if(el&&!el.contains(e.relatedTarget))tipHide();});
document.addEventListener('focusin',e=>{const el=e.target.closest&&e.target.closest('[data-tip]');if(el)tipShow(el);});
