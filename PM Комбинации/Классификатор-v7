input::placeholder,textarea::placeholder{color:var(--colorTextPlaceholder)}
select{appearance:none;-webkit-appearance:none;padding-right:28px!important;background-image:var(--ic-down-select)!important;background-repeat:no-repeat!important;background-position:right 9px center!important;background-size:12px!important}
.ddl select{padding-right:16px!important}
.pfield>label,.f label,.frow label{color:var(--colorTextSecondary);font-size:14px}
.f label{color:var(--colorTextSecondary);font-size:12px;margin-bottom:4px}
.pfield{gap:4px}
.pfield>label{font-size:12px;color:var(--colorTextSecondary)}
html body select.ph{color:var(--colorTextPlaceholder)}
#rules-gw{max-height:380px;overflow:auto}
