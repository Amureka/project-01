  /* алиасы старых переменных прототипа -> токены */
  --primary:var(--colorPrimary);--primary-d1:var(--colorPrimaryActive);--primary-l1:var(--colorPrimaryHover);--primary-l2:var(--colorPrimaryBorder);--primary-l3:var(--colorPrimaryBgHover);--primary-l4:var(--colorPrimaryBg);--primary-l5:var(--colorPrimaryBg);
  --success:var(--colorSuccess);--success-d1:var(--colorSuccessActive);--success-l1:var(--colorSuccessBorder);--success-l2:var(--colorSuccessBg);
  --error:var(--colorError);--error-l1:var(--colorErrorBorder);--error-l2:var(--colorErrorBg);
  --warning:var(--colorWarning);--warning-d1:var(--colorWarningActive);--warning-l1:var(--colorWarningBorder);--warning-l2:var(--colorWarningBg);
  --info-l2:var(--colorInfoBg);--slate:var(--colorTextSecondary);--slate-l2:var(--colorFillTertiary-solid);
  --gray:var(--colorTextSecondary);--gray-d1:var(--colorText);--gray-l1:var(--colorTextQuaternary);--gray-l2:var(--colorBorderSecondary);--gray-l3:var(--colorSplit);--gray-l4:var(--colorFillAlter-solid);
  --label:var(--colorTextTertiary);--link:var(--colorLink);--r:var(--borderRadius);
  --bg:var(--colorBgLayout);--surface:var(--colorBgContainer);--text:var(--colorText);
  color-scheme:light;box-sizing:border-box;
}

html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:13px/1.45 "SB Sans Interface",sans-serif}
a{color:var(--link);cursor:pointer;text-decoration:none}
b{font-weight:600}
.scroller{overflow-x:auto}
.frame{min-width:1220px;min-height:100vh}

.topnav{height:48px;background:var(--surface);border-bottom:1px solid var(--gray-l2);display:flex;align-items:center;padding:0 16px;gap:24px;position:sticky;top:env(safe-area-inset-top,0px);z-index:20}
.logo{display:flex;align-items:center;gap:8px;font-weight:600;white-space:nowrap}
.logo i{width:18px;height:18px;border-radius:50%;background:conic-gradient(from 20deg,var(--primary),var(--success),var(--primary))}
.topnav nav{display:flex;gap:2px}
.topnav nav a{padding:8px 8px;border-radius:var(--r);color:var(--gray);white-space:nowrap}
.topnav nav a:hover{background:var(--gray-l3)}
.topnav nav a.active{color:var(--primary-d1);background:var(--primary-l4);font-weight:600}
.nav-right{margin-left:auto;display:flex;align-items:center;gap:16px;color:var(--gray);white-space:nowrap}
.nav-right .plus{width:26px;height:26px;border:1px solid var(--gray-l2);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:16px}
.avatar{width:28px;height:28px;border-radius:50%;background:var(--primary-l3);color:var(--primary-d1);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600}

.screen{display:none}.screen.on{display:block}
.page{padding:16px 24px 32px;display:flex;flex-direction:column;min-height:calc(100vh - 48px)}
.crumbs{color:var(--gray);font-size:12px;margin-bottom:8px;display:flex;gap:8px}
.page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:8px}
h1{margin:0 0 4px;font-size:20px;font-weight:600;line-height:1.3}
.h1row{display:flex;align-items:center;gap:12px;margin-bottom:2px}
.h1row h1{margin:0}
.topnav nav a svg{width:14px;height:14px;vertical-align:-2px;margin-right:8px;fill:none;stroke:currentColor;stroke-width:1.8}
.meta{display:flex;flex-wrap:wrap;gap:8px 16px;color:var(--gray);font-size:12px;align-items:center}
.actions{display:flex;gap:8px;align-items:center;flex-shrink:0}
.toolbar{display:flex;gap:8px;margin-bottom:12px;align-items:center}
.toolbar input,.toolbar select{height:32px;border:1px solid var(--gray-l2);border-radius:var(--r);padding:0 8px;font:inherit;background:var(--surface);color:var(--text)}
.toolbar input{width:280px}
.panel{background:var(--surface);border:1px solid var(--gray-l2);border-radius:var(--r)}
.panel-head{display:flex;align-items:center;justify-content:space-between;padding:8px 8px;border-bottom:1px solid var(--gray-l2);min-height:40px}
.panel-head .right{display:flex;gap:8px;align-items:center}
.muted{color:var(--gray);font-size:12px}

.btn{height:34px;padding:0 16px;border-radius:4px;border:0;background:var(--colorPrimaryBg);color:var(--colorPrimaryActive);font:inherit;font-size:14px;cursor:pointer;white-space:nowrap}
.btn:hover{background:var(--colorPrimaryBgHover)}
.btn.primary{background:var(--colorPrimary);color:var(--colorWhite)}
.btn.primary:hover{background:var(--colorPrimaryActive)}
.btn.sm{height:28px;padding:0 8px;font-size:14px}
.btn.icon{width:34px;padding:0;font-size:16px}
.btn.on{background:var(--primary-l4);border-color:var(--primary-l2);color:var(--primary-d1)}
.btn.danger{background:var(--error);color:var(--colorWhite)}.btn.danger:hover{background:var(--colorErrorActive)}
.btn:disabled{opacity:.45;cursor:default;border-color:var(--gray-l2)}
.btn:focus-visible,.tabs button:focus-visible,.seg button:focus-visible{outline:2px solid var(--primary-l1);outline-offset:1px}
.chip{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:11px;font-size:12px;font-weight:600;white-space:nowrap}
.chip.draft{background:var(--slate-l2);color:var(--slate)}
.chip.ok{background:var(--success-l2);color:var(--success-d1)}
.chip.ver{background:var(--primary-l4);color:var(--primary-d1)}
.seg{display:inline-flex;border:1px solid var(--gray-l2);border-radius:var(--r);overflow:hidden}
.seg button{border:0;background:var(--surface);padding:4px 8px;font:inherit;font-size:12px;color:var(--gray);cursor:pointer}
.seg button.on{background:var(--primary-l4);color:var(--primary-d1);font-weight:600}
.seg button:disabled{color:var(--gray-l1);cursor:default}
.tabs{display:flex}
.tabs button{border:0;background:transparent;padding:8px 8px;font:inherit;color:var(--gray);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-8px}
.tabs button.on{color:var(--primary-d1);border-bottom-color:var(--primary)}
.badge{background:var(--warning-l2);color:var(--warning-d1);border-radius:9px;padding:0 8px;font-size:12px;margin-left:4px;font-weight:400}

table{border-collapse:collapse;width:100%}
th{text-align:left;font-size:12px;color:var(--gray);font-weight:600;background:var(--gray-l4);padding:8px;border-bottom:1px solid var(--gray-l2);white-space:nowrap}
td{padding:8px;border-bottom:1px solid var(--gray-l3);vertical-align:middle}
tr.row{cursor:pointer}
tr.row:hover td{background:var(--primary-l5)}
.num{text-align:right;font-variant-numeric:tabular-nums}
.list a.name{font-weight:600}
td.ic{width:96px;white-space:nowrap;text-align:right}
td.ic a{opacity:0;margin-left:8px;color:var(--gray);font-size:14px;transition:opacity .1s}
tr:hover td.ic a{opacity:1}
td.ic a:hover{color:var(--text)}

.status-line{display:flex;align-items:center;gap:16px;margin:2px 0 12px;color:var(--gray);font-size:14px;flex-wrap:wrap;min-height:20px}
.status-line .bar.run i{animation:fill 2.2s linear forwards;background:var(--primary)}
.status-line .bar{width:180px;height:6px;background:var(--gray-l3);border-radius:3px;overflow:hidden}
.status-line .bar i{display:block;height:100%;background:var(--success)}
.status-line b{color:var(--text)}
.status-line .warn b{color:var(--warning-d1)}
.status-line span[title]{border-bottom:1px dotted var(--gray-l1);cursor:help}

/* rules grid: admin look (glide-data-grid) */
.rules{table-layout:auto}
.rules td.c{position:relative;cursor:default;max-width:360px;overflow:hidden;text-overflow:ellipsis}
.rules td.c.sel{outline:2px solid var(--primary);outline-offset:-2px;background:var(--primary-l5)}
.rules.edit td.c.dd::before{content:"";position:absolute;left:0;top:0;border:6px solid transparent;border-top-color:var(--error);border-left-color:var(--error)}
.rules td.c.err{background:var(--error-l2)}
.rules td.c.editing{padding:0;overflow:visible}
.rules .editor{width:100%;height:36px;border:2px solid var(--primary);border-radius:0;padding:0 8px;font:inherit;font-size:14px;background:var(--surface);color:var(--text);outline:none;box-sizing:border-box}
.rules tr.trail td{color:var(--gray-l1);cursor:pointer;font-size:12px;background:var(--surface)}
.rules tr.trail:hover td{color:var(--primary-d1);background:var(--primary-l5)}
.rules tr.rowsel td{background:var(--primary-l4)}
.fpanel{border-bottom:1px solid var(--gray-l2);font-size:14px;position:relative}
.fpanel .ftog{display:inline-block;padding:8px 12px;color:var(--text);cursor:pointer}
.fpanel .fcount{display:inline-block;min-width:18px;height:18px;border-radius:9px;background:var(--primary);color:var(--colorWhite);font-size:12px;text-align:center;line-height:18px;margin-left:8px}
.fpanel .fcount:empty{display:none}
.fpanel .lastupd{position:absolute;right:12px;top:9px;color:var(--gray);font-size:12px}
.frow{display:flex;gap:8px;align-items:center;margin-bottom:8px;width:100%}
.frow select,.frow input{height:34px;border:1px solid var(--gray-l2);border-radius:var(--r);padding:0 8px;font:inherit;font-size:14px;background:var(--colorBgContainer);color:var(--text);flex:1;min-width:0}
.frow .ico{width:20px;text-align:center;color:var(--gray);cursor:pointer;flex:none}
.frow .ico:hover{color:var(--text)}
.fpanel .ftog:hover{color:var(--primary-d1)}
.fpanel .fbody{display:none;padding:4px 12px 8px;max-width:1100px}
.fpanel.open .fbody{display:block}
.fpanel .fbody label{color:var(--colorTextSecondary)}
.fpanel .fbody input,.fpanel .fbody select{height:26px;border:1px solid var(--gray-l2);border-radius:var(--r);padding:0 8px;font:inherit;font-size:12px;background:var(--surface);color:var(--text)}
.fpanel .fbody input{width:170px}

.tbl-panel{flex:1;display:flex;flex-direction:column}
.grid-wrap{overflow:auto;flex:1;min-height:380px}
.rules th,.rules td{padding:8px;height:38px;border-right:1px solid var(--gray-l3);font-size:14px;white-space:nowrap}
.rules th{background:var(--surface);color:var(--gray-d1);font-weight:600;font-size:14px;border-bottom:1px solid var(--gray-l2);text-align:left;position:sticky;top:0;z-index:2}
.rules th .arr{float:right;color:var(--gray-d1);font-size:12px;margin:1px 0 0 8px}
.rules th.num{text-align:left}
.rules tr.r td{border-bottom:1px solid var(--gray-l3)}
.rules tr.first td{border-top:1px solid var(--gray-l2)}
.rules tr.selrule td{background:var(--primary-l5)}
.rules td.rep{color:var(--gray-l1)}
.rules td.join{text-align:center;color:var(--gray);font-weight:600;font-size:12px}
.rules td.cnt{text-align:right;font-variant-numeric:tabular-nums}
.rules td.cnt.ov{color:var(--warning-d1);font-weight:600}
.rules td.cnt.zero{color:var(--gray-l1)}
.rules td.complex{color:var(--gray);font-style:italic}
.rules td.complex a{font-style:normal;margin-left:8px}
.rules td.w0{width:22px;padding:0;text-align:center;color:var(--gray-l1);cursor:grab;letter-spacing:-2px}
.rules td.rowact{width:40px;text-align:center}
