.chk-meta{color:var(--colorTextDescription);font-size:12px}
.chk-meta a{font-size:12px}
.page>.pagebar{margin-bottom:16px}
.status-line{margin:0 0 8px;min-height:0}
.status-line:empty,#cd-lock:empty{display:none}
/* ячейка: размер не меняется */
.rules td.c.editing{position:relative;padding:0 8px;overflow:visible}
.rules td.editing .sizer{display:block;height:0;overflow:hidden;visibility:hidden;white-space:nowrap}
.rules td.editing .editor{position:absolute;left:0;top:0;width:100%;height:100%;box-sizing:border-box;padding:0 8px}
.rules tr.selrule td:first-child{box-shadow:inset 3px 0 0 var(--colorPrimary)}
/* v4b */
#pane-cls .pmf .pfield{width:280px!important}
#pane-cls .pmf .pfield:last-child{width:320px!important}
table.list{width:100%!important;table-layout:auto}
table.list th:first-child,table.list td:first-child{min-width:300px}
table.list td:nth-child(2){min-width:260px}
#cd-line{margin:0 16px 12px}
#cd-line:empty{display:none}
/* responsive ≥980 */
@media (max-width:1280px){
 html,body{overflow-x:hidden}
 .topnav .logo{padding:0 12px;font-size:0;gap:0}
 .topnav .logo i{margin:0}
 .topnav nav a{padding:0 8px}
 .topnav .nav-right .btn,.topnav .nav-right .settings{font-size:0}
 .topnav .nav-right{gap:4px;padding-right:8px}
 .page-head.pagebar{flex-wrap:wrap;row-gap:8px}
 .pagebar .ph-title{flex:1 1 280px}
 .pmf{flex-wrap:wrap}
 #pane-cls .pmf .pfield,#pane-cls .pmf .pfield:last-child{width:calc(33.333% - 6px)!important;min-width:200px}
 .panel,.grid-wrap{overflow-x:auto}
 table.list{min-width:1000px}
 .fpanel .frow{flex-wrap:wrap}
 .dtools{flex-wrap:wrap}
}
@media (max-width:1100px){
 .topnav nav a{padding:0 8px;font-size:13px}
 .pagebar .tabs-pill,.pagebar .subtabs{order:3}
}
@media (max-width:1100px){
 .topnav .nav-right>span{padding:0 4px!important;margin:0!important;font-size:13px}
 .topnav nav a{padding:0 8px;font-size:13px}
}
/* ================= v5 ================= */
/* фильтры — явно часть таблицы, не отдельная карточка */
.fpanel{margin:0!important;border:0!important;border-radius:0!important;background:transparent!important;overflow:visible!important;border-bottom:0!important}
.fpanel .ftog{padding:12px 16px!important;background:transparent!important}
.fpanel.open .ftog{border-bottom:0!important;padding-bottom:0!important}
.fpanel .fbody,#cd-data .fpanel .fbody{padding:4px 16px 4px!important;max-width:none!important}
/* 12px между «Очистить» и строкой поиска (8px у fclr + 4px здесь) */
#cd-data .fpanel .fbody{padding-bottom:4px!important}
#cd-data .dtools{padding-top:0}
.fpanel .lastupd{position:absolute!important;top:7px;right:16px;margin:0!important;text-align:right}
/* таблицы — паддинги как у тулбара (поиск + кнопка) */
.grid-wrap,.data-body{margin:0 16px 16px}
.grid-wrap table,.data-body table{width:100%}
.grid-wrap table tr:last-child td,.data-body table tr:last-child td{border-bottom:1px solid var(--colorBorderSecondary)}

/* единый блок статуса проверки */
/* replaced by .chk-row in v6 */
.chk-pct{color:var(--colorText);white-space:nowrap;font-weight:400}
.chk-pct b{font-weight:600}
#cd-line{display:flex;flex-direction:column;gap:8px;margin:8px 16px 12px}
#cd-line:empty{display:none!important}
#cd-line .bar{width:100%;height:4px}
.alert{display:flex;align-items:flex-start;gap:8px;padding:8px 12px;border-radius:var(--borderRadius);background:var(--colorWarningBg);color:var(--colorText);font-size:13px;line-height:1.5}
.alert .anticon{flex:none;color:var(--colorWarning);margin-top:2px;line-height:0}
.alert .anticon svg{width:14px;height:14px}
.alert.alert-info{background:var(--colorInfoBg);border:1px solid var(--colorInfoBorder)}
.alert.alert-info .anticon{color:var(--colorInfo)}
.alert.sm{align-items:center;padding:8px 12px;border-radius:var(--borderRadiusLG);font-size:14px;line-height:1.5714;margin-top:8px}
.alert.sm .anticon{margin-top:0;color:var(--colorInfo)}
.alert.sm .anticon svg{width:14px;height:14px}
th.num{text-align:left!important}

/* результат проверки — обычный блок внизу страницы (без сплита/фикс. высоты) */
#cd-res{margin-bottom:16px}
/* ================= v6 ================= */
/* блок статуса проверки — отдельная карточка под шапкой */
.chkpanel{margin-top:0;margin-bottom:16px;padding:16px}
#cd-line{display:flex;flex-direction:column;gap:8px;margin:0}
#cd-line:empty{display:none!important}
#cd-line:not(:empty){margin-top:8px}
#cd-line .bar{width:100%;height:4px}

/* v7 — статрибон: метрики-ячейки + кнопка-действие справа, прогресс-бар — внутри ячейки "Размечено" */
.chk-stats{display:flex;align-items:center;gap:16px}
.chk-stat{display:flex;flex-direction:column;gap:3px;flex:1 1 0;padding-right:16px;border-right:1px solid var(--divider);min-width:0}
.chk-stat:last-of-type{border-right:0;padding-right:0}
.chk-stat .lbl{font-size:12px;color:var(--colorTextSecondary);white-space:nowrap}
.chk-stat .val{font-size:14px;color:var(--colorText);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:flex;align-items:center;gap:8px}
.chk-stat .val .srcl{font-weight:600;min-width:0}
.chk-stat .val .srcn{overflow:hidden;text-overflow:ellipsis}
.chk-stat .val .sub{font-weight:400;color:var(--colorTextSecondary);margin-left:2px}
.chk-act{flex:none}
.chk-act .btn{display:inline-flex;align-items:center;gap:8px}
.chk-act .btn[disabled]{opacity:.5;cursor:not-allowed}
.chk-act .btn[disabled]:hover{background:var(--colorPrimaryBg)}
.chk-pbar{width:120px;height:5px;border-radius:100px;overflow:hidden;background:var(--colorFillSecondary);margin-top:1px}
.chk-pbar i{display:block;height:100%;background:var(--colorSuccess);border-radius:100px}
.chk-pbar.run i{background:var(--colorPrimary);animation:fill 2.2s linear forwards}
/* иконка "классификатор устарел" слева от даты последней проверки: 12px, 8px до значения, тултип по ховеру */
.chk-stat .val{gap:0}
.chk-stat .val .sub{margin-left:8px}
.stale-ic{flex:none;width:12px;height:12px;margin-right:8px;background:var(--colorWarning);-webkit-mask:var(--ic-info) no-repeat center/contain;mask:var(--ic-info) no-repeat center/contain;cursor:help}
.stale-ic:hover{background:var(--colorWarningActive)}

/* кнопка-тоггл «Результат проверки» в активном состоянии */
.tabbar .right .btn.on{background:var(--colorPrimaryBg);border-color:var(--colorPrimaryBorder);color:var(--colorPrimaryTextActive)}
/* ================= v7 ================= */

/* чипы результата проверки — табы вместо раздельных pill-кнопок */
.qchip.tabchip{background:transparent;border:0;border-bottom:2px solid transparent;border-radius:0;padding:0 0 8px;margin-right:28px;color:var(--colorText);font-size:14px;font-weight:400}
.qchip.tabchip:hover{color:var(--colorPrimaryHover)}
.qchip.tabchip.on{color:var(--colorPrimary);border-bottom-color:var(--colorPrimary);background:transparent}
.qchip.tabchip .badge{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;margin-left:8px;padding:0 8px;border-radius:10px;background:var(--colorFillSecondary);color:var(--colorTextSecondary);font-size:12px;font-weight:400;line-height:20px}
.qchip.tabchip.on .badge{background:var(--colorPrimaryBg);color:var(--colorPrimaryTextActive)}
#cd-res .dtools{align-items:flex-end;gap:0 0}
#cd-res .dtools .ps{margin-right:24px;align-self:center}
/* ================= v8 ================= */
/* пустое состояние в стиле Superset/antd Empty */
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:220px;padding:24px 16px;color:var(--colorTextDescription)}
.empty-state .es-ic{line-height:0;margin-bottom:4px}
.empty-state .es-ic svg{width:82px;height:68px}
.empty-state .es-title{font-size:14px;color:var(--colorTextDescription);font-weight:400}
.empty-state .es-desc{font-size:14px;color:var(--colorTextDescription);text-align:center;max-width:380px;line-height:1.5}
td .empty-state{min-height:160px;padding:24px 16px}

/* фильтры — аккордеон: клик по «Фильтры» сворачивает/разворачивает */
.fpanel .ftog .anticon{display:inline-flex;transition:transform .2s}
.fpanel.open .ftog .anticon{transform:rotate(90deg)}

/* хинт "Результат проверки": ровно 8px от текста заголовка (заголовок+хинт — один flex-блок, space-between panel-head не раздвигает их) */
#cd-res .panel-head .ptitle{padding:0}
#cd-res .panel-head .vleft{display:flex;align-items:center}
#cd-res .panel-head .ihelp{margin-left:8px}
/* результат проверки: табы под поиском, меньший размер (antd size="small"), найдено - справа как в блоке датасета */
/* отступы контента «Результат проверки»: шапка→фильтры 12px, «Очистить»→контент ниже 8px, alert→таблица 8px */
#cd-res>.panel-head{min-height:0;padding:12px 16px 0;border-bottom:0}
#cd-res .dtools{border-bottom:0;padding-bottom:0;padding-top:0}
/* от кнопки «Очистить» до контента ниже — 8px */
#cd-res .fclr{padding:0 0 8px}
#cd-res .fpanel .fbody{padding-bottom:0!important}
#cd-res .alert{margin:0 16px 8px}
.restabs{display:flex;gap:0;margin:8px 16px 0;border-bottom:1px solid var(--colorBorderSecondary)}
.restabs button{margin:0 20px -1px 0}
.qchip.tabchip.sm{padding:0 0 8px;font-size:13px}
.qchip.tabchip.sm .badge{min-width:18px;height:18px;line-height:18px;font-size:11px}
/* фиксированная высота таблицы примеров: карточка не меняет размер при переключении табов */
#cd-res .data-body{height:380px}
/* пустое состояние таблицы примеров: заглушка на всю высоту, линия под последней строкой не нужна */
#cd-res .data-body table.es{height:100%}
#cd-res .data-body table.es tr{height:100%}
#cd-res .data-body table.es td{border-bottom:0;vertical-align:middle;padding:0}
#cd-res .data-body table.es td .empty-state{height:100%;min-height:0;box-sizing:border-box}

/* ================= v9 ================= */
/* заголовок «Версия N» внутри блока Правила: счётчики слева */
/* контент «Правила»: 12px от табов до строки версии, 12px от версии до фильтров (у ftog padding-top 12px) */
.verhead{padding:16px 16px 8px;min-height:0;border-bottom:0}
.verhead .vleft{display:flex;align-items:center;gap:8px}
.verhead .right{display:flex;align-items:center;gap:12px;font-size:13px}
/* мета «когда обновлено» — 1:1 параметры MetadataBar из Superset 6
   (superset-ui-core/src/components/MetadataBar): плашка padding 8px 12px, фон colorBgLayout,
   скругление borderRadius, шрифт fontSizeSM 12; иконка EditOutlined 16px colorTextTertiary, отступ до текста 8px;
   текст colorTextSecondary, max-width 150px с многоточием */
.updmeta{display:inline-flex;align-items:center;padding:8px 12px;background:var(--colorBgLayout);border-radius:var(--borderRadius);font-size:12px;line-height:1;cursor:default;outline:none}
.updmeta .anticon{color:var(--colorTextTertiary);padding-right:8px}
.updmeta .updmeta-text{color:var(--colorTextSecondary);line-height:1.4;white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis}
/* в строке заголовка бейдж статуса и мета стоят в один ряд */
#cd-status{display:inline-flex;align-items:center;gap:8px}

/* таблица правил в карточке — максимум 25 строк, остальное скроллится (header остаётся липким) */
#rules-gw{overflow:auto}

/* ================= v10 ================= */
/* 1. шапка карточки (Title) закрепляется при скролле; меню сервиса сверху — отдельно */
.page-head.pagebar{position:sticky;top:48px;z-index:15}

/* 1а. без отступа между заголовком и белой полосой табов на главной */
#s-home .page-head.pagebar{margin-bottom:0}

/* 1б. табы «Классификаторы/Каталог операций» — на белом, сразу под заголовком; фильтры ниже — на серой подложке страницы */
#pane-cls .tabs-row,#pane-cat .tabs-row{background:var(--colorBgContainer);margin:0 -16px;padding:0 16px}
/* таблица списка классификаторов — радиус 4px */
#pane-cls .panel:has(table.list){border-radius:4px}
#pane-cls .pmf,#pane-cat .pmf{background:var(--colorBgLayout);padding:16px;margin:16px -16px 16px}

/* 2. «Создать правило» — операция+приоритет строкой под строками датасета */
.rule-cta{display:flex;align-items:flex-end;flex-wrap:wrap;gap:12px;padding:16px;border-top:1px solid var(--colorBorderSecondary)}
.rule-cta .f{margin:0}
.rule-cta .f.rc-op{width:260px}
.rule-cta .f.rc-pr{width:120px}
.rule-cta .btn{flex:none}
.pr-wrap{position:relative;display:block}
.pr-wrap>input{padding-left:24px}
.pr-wrap .ihelp{position:absolute;left:8px;top:50%;transform:translateY(-50%);margin:0}
.pr-wrap .ihelp.warn{-webkit-mask:var(--ic-info) no-repeat center/contain;mask:var(--ic-info) no-repeat center/contain;background:var(--colorWarning)}
.pr-wrap .ihelp.warn:hover{background:var(--colorWarningActive)}
.ihelp.info{-webkit-mask:var(--ic-info) no-repeat center/contain;mask:var(--ic-info) no-repeat center/contain}

/* 3. иконка-лупа слева во всех инпутах поиска (не только в .pfield) */
.sinput{position:relative}
.sinput input{padding-left:32px!important}
.sinput::before{content:'';position:absolute;left:10px;top:50%;width:15px;height:15px;transform:translateY(-50%);background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239AA0A6' stroke-width='2'><circle cx='11' cy='11' r='7'/><path d='M20 20l-4-4'/></svg>") no-repeat center/contain;pointer-events:none}

/* 4. «открыть в новом окне» — стрелка вверх-вправо вместо вниз-вправо */
.ghost-ic svg{transform:scaleY(-1)}

/* 5. мультивыбор значения фильтра — теги вместо «через запятую» */
.msel{display:flex;flex-wrap:wrap;gap:4px;align-items:center;min-height:34px;border:1px solid var(--colorBorderSecondary);border-radius:var(--borderRadius);padding:3px 24px 3px 8px;flex:1;min-width:0;background:var(--colorBgContainer);cursor:text}
.msel.msel-open{border-color:var(--colorPrimary);box-shadow:0 0 0 2px var(--colorPrimaryOutline-d)}
.msel.dis{background:var(--colorFillTertiary);cursor:not-allowed}
.msel .ms-ph{color:var(--colorTextDisabled);font-size:13px;padding:0 2px}
.msel input{border:0;outline:0;flex:1;min-width:60px;height:24px;padding:0 2px;font:inherit;font-size:13px;background:transparent}
.ms-dd{min-width:160px}
.ant-dd-item.ms-item{gap:8px}
.ms-check{flex:none;width:14px;color:var(--colorPrimary);font-size:13px;line-height:1}
.ant-dd-item.ms-item.sel{font-weight:600}
/* чип в мультивыборе — antd Select selection-item: multipleItemBg rgba(0,0,0,.06), transparent border, height 24, radius SM 4, padding 4, font 14 */
.mtag{display:inline-flex;align-items:center;gap:4px;box-sizing:border-box;max-width:100%;min-width:0;height:24px;padding:0 4px;border:1px solid transparent;border-radius:var(--borderRadiusSM);background:var(--colorFillSecondary);color:var(--colorText);font-size:14px;line-height:22px;white-space:nowrap}
.mtag a{flex:none;cursor:pointer;color:var(--colorIcon);font-size:12px;font-weight:400;line-height:1;padding:0 2px}
.mtag a:hover{color:var(--colorIconHover)}
/* фильтры каталога: размеры как на «Классификаторах» (поле 280px, контрол 32px), счётчик справа */
#pane-cat .pmf .pfield{width:280px!important}
#pane-cat .pmf .msel{height:32px;min-height:32px;padding:0 24px 0 4px;flex-wrap:nowrap;overflow:hidden}
.cat-cnt{margin-left:auto;align-self:center;font-size:13px;white-space:nowrap}
.msf-pop .msf-list{max-height:240px;overflow:auto}
.msel .fc-n{min-width:0;overflow:hidden;text-overflow:ellipsis}
/* таблица каталога: без отступов контейнера по краям панели, паддинги ячеек обычные (8px) */
#pane-cat .cat-main .grid-wrap{margin-left:0;margin-right:0}
/* ================= v11 ================= */
/* список классификаторов: название — regular */
.list a.name{font-weight:400}
/* фильтры списка: без отступов сверху/снизу у полосы фильтров */
#pane-cls .pmf,#pane-cat .pmf{margin:0 -16px}
/* Superset Select (react-select): поле с поиском внутри, меню с группами и подсветкой */
.ssel{position:relative;display:flex;align-items:center;height:32px;padding:0 24px 0 8px;border:1px solid var(--colorBorder);border-radius:4px;background:var(--colorBgContainer);cursor:pointer;font-size:14px;user-select:none;width:100%;box-sizing:border-box;transition:border-color .2s,box-shadow .2s}
.ssel:hover{border-color:var(--colorPrimaryHover)}
.ssel.ss-open{border-color:var(--colorPrimary);box-shadow:0 0 0 2px var(--colorPrimaryOutline-d)}
.ssel .ss-v{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--colorText)}
.ssel .ss-v.ph{color:var(--colorTextPlaceholder)}
.ssel .ss-in{display:none;flex:1;min-width:0;height:100%;border:0;outline:0;background:transparent;font:inherit;font-size:14px;color:var(--colorText);padding:0;cursor:inherit}
.ssel .ss-in::placeholder{color:var(--colorTextPlaceholder)}
.ssel.ss-open .ss-v{display:none}
.ssel.ss-open .ss-in{display:block}
.ssel::after{content:"";position:absolute;right:9px;top:50%;transform:translateY(-50%);width:12px;height:12px;background:var(--colorTextQuaternary);-webkit-mask:var(--ic-down) no-repeat center/contain;mask:var(--ic-down) no-repeat center/contain;pointer-events:none;transition:transform .2s}
.ssel.ss-open::after{transform:translateY(-50%) rotate(180deg)}
.ssel .ss-x{display:none;position:absolute;right:9px;top:50%;transform:translateY(-50%);width:12px;height:12px;background:var(--colorTextQuaternary);-webkit-mask:var(--ic-close) no-repeat center/contain;mask:var(--ic-close) no-repeat center/contain;cursor:pointer}
.ssel .ss-x:hover{background:var(--colorText)}
.ssel.ss-has:hover::after{display:none}
.ssel.ss-has:hover .ss-x{display:block}
.ssmenu{max-height:264px;overflow:auto;padding:4px}
.ss-grp{padding:8px 8px 2px;font-size:12px;color:var(--colorTextTertiary);cursor:default}
.ssmenu .ant-dd-item{padding:8px 8px;border-radius:0}
.ssmenu .ant-dd-item:hover,.ssmenu .ant-dd-item.act{background:var(--colorPrimaryBg)}
.ssmenu .ant-dd-item.sel{background:var(--colorPrimaryBg);font-weight:600;color:var(--colorPrimaryTextActive)}
.ss-none{padding:8px;color:var(--colorTextTertiary);font-size:13px;text-align:center}
/* фильтры панели: 4px от «Фильтры» до инпутов, без нижнего паддинга; «Очистить» под рядами слева */
.fpanel .fbody,#cd-data .fpanel .fbody{padding:4px 12px 0}
.fclr{padding:0 0 8px}
/* контент «Правила»: от «Очистить» до контента ниже (alert или таблица) — 8px, без нижнего паддинга fbody */
#cd-rules .fpanel .fbody{padding-bottom:0!important}
#cd-rules .fclr{padding:0 0 8px}
/* создание правила: без разделителя, кнопка сразу за приоритетом по низу; 8px от таблицы датасета до блока */
.rule-cta{border-top:0;padding-top:0}
#cd-data:has(.rule-cta) .data-body{margin-bottom:8px}
/* «Версия N»: без паддингов у ptitle */
.verhead .ptitle{padding:0}
/* красные углы ячеек с дропдауном — как в админке Superset (glide-data-grid), показываются всегда */
/* «Версии правил»: отступ между табами/шапкой и таблицей — как между табами и строкой «Версия N» (.verhead: padding-top 10px + центрирование в 46px) */
#cd-rules .tabbar+.grid-wrap,#cd-rules .verhead+.grid-wrap{padding-top:16px}
/* кнопка «Назад» в просмотре версии правил — маленькая default-кнопка AntD (controlHeightSM 24px, иконка 14px) */
.verback{width:24px;height:24px;flex:none;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--colorBorder);border-radius:var(--borderRadius);background:var(--colorBgContainer);color:var(--colorText);cursor:pointer;transition:border-color .2s,color .2s}
.verback:hover{border-color:var(--colorPrimary);color:var(--colorPrimary)}
.verback:focus-visible{outline:2px solid var(--colorPrimaryBorder);outline-offset:2px}
/* пустое состояние «Версий правил»: картинка и текст по центру на всю высоту карточки */
#cd-rules .grid-wrap.es-wrap{display:flex;padding-bottom:0}
#cd-rules .grid-wrap.es-wrap>.empty-state{flex:1;min-height:0}
/* ================= v12 ================= */
/* тултип обрезанного текста: обрезается сам текст, тултип позиционируется над ним, а не над ячейкой */
.trunctip{display:inline-block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom;font-weight:inherit}
/* модалка «Разблокировка таблиц»: карточки заблокированных таблиц с кнопкой внутри */
.ulk-list{display:flex;flex-direction:column;gap:8px;max-height:min(56vh,480px);overflow:auto;margin-top:0}
.ulk-card{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 16px;border:1px solid var(--colorBorderSecondary);border-radius:4px;background:var(--colorBgContainer)}
.ulk-card .ulk-main{min-width:0}
.ulk-name{font-size:14px;color:var(--colorText);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ulk-meta{margin-top:2px;font-size:12px;color:var(--colorTextSecondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ulk-card .btn{flex:none}
/* normal-текст вместо label в модалке «Удалить операцию» */
.ntxt{font-size:14px;font-weight:400;color:var(--colorText);margin-bottom:8px}
/* попап «Процессы ARIS»: помещается на экране, список внутри скроллится, поиск и подвал закреплены (как antd Select multiple) */
.menu.open.popcol{display:flex;flex-direction:column;overflow:hidden}
.menu.popcol .pp-list{flex:1;min-height:0;overflow:auto;max-height:256px}
.menu.popcol>*:not(.pp-list){flex:none}
/* ================= v13 ================= */
/* хинт заголовка страницы: «i» в круге, контурный (stroke, не заливка), 16px, отступ от заголовка 12px */
.ihelp.info{-webkit-mask:var(--ic-info-o) no-repeat center/contain;mask:var(--ic-info-o) no-repeat center/contain}
.ihelp.big.info{width:16px;height:16px}
#s-home .ph-title.titlerow{gap:12px}
#s-home .titlerow .ihelp{margin-left:0}
/* ================= v14 ================= */
/* селекты «Статус»/«Источник» по спецификации antd Select v5:
   селектор: radius 6, hover/active border; дропдаун: radius 8, padding 4, тень;
   опции: 32px, padding 5px 12px, radius 4, hover серый (controlItemBgHover),
   выбранная — colorPrimaryBg + 600 (без синего текста); группы — 12px colorTextDescription */
.ssel{border-radius:var(--borderRadius)}
.ssel .ss-x:hover{background:var(--colorTextTertiary)}
.ssmenu{max-height:256px;padding:4px}
.ssmenu .ant-dd-item{min-height:32px;padding:5px 12px;border-radius:var(--borderRadiusSM);color:var(--colorText);font-weight:400}
.ssmenu .ant-dd-item:hover,.ssmenu .ant-dd-item.act{background:var(--colorFillTertiary-solid);color:var(--colorText)}
.ssmenu .ant-dd-item.sel{background:var(--colorPrimaryBg);font-weight:600;color:var(--colorText)}
.ssmenu .ant-dd-item.sel:hover,.ssmenu .ant-dd-item.sel.act{background:var(--colorPrimaryBgHover);color:var(--colorText)}
.ssmenu .ss-grp{padding:0 12px;line-height:32px;font-size:12px;font-weight:400;color:var(--colorTextDescription);cursor:default;background:transparent}
.ssmenu .ss-none{padding:16px 0;color:var(--colorTextDescription);font-size:14px;text-align:center}
/* поиск внутри кастомного селекта — не оборачиваем в рамку/обводку (иначе «селект в селекте») */
.ssel .ss-in,.ssel .ss-in:hover,.ssel .ss-in:focus{border:0;border-color:transparent;background:transparent;border-radius:0;box-shadow:none;outline:0}
/* «Результат проверки»: отступы между бэйджами справа от заголовка — 4px */
#cd-res .panel-head .bdg+.bdg{margin-left:4px}
#cd-res .panel-head .ihelp+.bdg{margin-left:4px}
/* таблица «Результата проверки» — antd Table size="small":
   ячейки padding 8px 8px, текст 14px/22px (не 12px), шапка 600 colorTextHeading на colorFillAlter,
   hover строки colorFillAlter; разделители строк — цвет уже задан глобальным правилом td (colorBorderSecondary) */
#cd-res .rtab th,#cd-res .rtab td{padding:8px;font-size:14px;line-height:22px}
#cd-res .rtab th{font-weight:600;color:var(--colorTextHeading);background:var(--colorFillAlter-solid)}
#cd-res .rtab td{color:var(--colorText)}
#cd-res .rtab tbody tr:hover td{background:var(--colorFillAlter-solid)}
#cd-res .rtab tbody tr.hit:hover td{background:var(--colorSuccessBg)}
/* селекты фильтров «Каталога операций» (Домены/Процессы ARIS/Классификаторы) — antd Select multiple:
   рамка colorBorder (#d9d9d9), а не colorBorderSecondary; placeholder 14px colorTextPlaceholder;
   тег-чип: высота 22px (multipleItemHeight), фон colorFillSecondary, radius 4; disabled — как antd */
.pmf .msel{border-color:var(--colorBorder)}
.pmf .msel .ms-ph{font-size:14px;color:var(--colorTextPlaceholder)}
.pmf .msel .mtag{height:22px;line-height:20px}
.pmf .msel.dis{background:var(--colorBgContainerDisabled-solid);border-color:var(--colorBorder);cursor:not-allowed}
/* ================= v15 ================= */
/* структура панелей: «Фильтры» → инпуты → «Очистить» → 12px → инпут поиска → 12px → таблица */
/* ровно 12px от «Очистить» до контента ниже (поиск, alert или таблица) во всех панелях */
.fpanel .fclr{padding:0 0 12px!important}
.fpanel .fbody,#cd-data .fpanel .fbody,#cd-rules .fpanel .fbody,#cd-res .fpanel .fbody{padding-bottom:0!important}
/* 12px от строки поиска до таблицы («Данные датасета») / до табов примеров («Результат проверки») */
#cd-data .dtools,#cd-res .dtools{padding-top:0;padding-bottom:12px}
#cd-res .restabs{margin-top:0}
/* результат проверки: таблицы «Сводка» и «Строки» (примеры) — рядом, как два таба в исходном макете */
#cd-res .res-cols{display:flex;gap:16px;margin:0 16px 16px;align-items:stretch}
#cd-res .res-sum{flex:2 1 0;min-width:0;display:flex;flex-direction:column}
#cd-res .res-rows{flex:3 1 0;min-width:0;display:flex;flex-direction:column}
#cd-res .res-cols .restabs{margin:0}
#cd-res .restabs span.qchip{cursor:default;margin-bottom:-1px}
#cd-res .res-cols .data-body{margin:0;flex:1;overflow:auto}
#cd-res .sumt th{white-space:normal}
@media (max-width:1280px){#cd-res .res-cols{flex-wrap:wrap}#cd-res .res-sum{flex:1 1 100%}}
/* ==== новая сборка карточки: табы «Правила / Данные датасета» под шапкой ==== */
#cd-tabs-row{margin-bottom:16px}
#cd-tabs .tab-lnk{cursor:pointer}
/* табы итогов проверки над таблицей датасета */
.dstabs{display:flex;align-items:center;padding:0 8px;margin:0 0 8px;border-bottom:1px solid var(--colorBorderSecondary)}
.dstabs button{margin:0 20px -1px 0}
.dstabs .ihelp{margin-left:2px}
#cd-data .data-body{max-height:none}
/* панель фильтров без сворачивания: ряд «Правила» + условия; 16px от верха карточки до селекта */
#cd-data .fpanel .fbody{padding:16px 12px 4px;max-width:none}
#cd-data .fpanel .fbody .rp-row{margin-bottom:8px}
.rp-row select{max-width:420px}
/* кнопки результата в блоке статуса */
.chk-act{display:flex;gap:8px;align-items:center}
/* панель «Результат проверки» как в Superset: dock снизу, без маски, фон кликабелен, resizable за верхний край */
#drw-result{position:fixed;inset:0;display:none;z-index:30;pointer-events:none}
#drw-result.open{display:block}
.drw{position:absolute;left:0;right:0;bottom:0;background:var(--colorBgElevated);border-top:1px solid var(--colorBorderSecondary);box-shadow:0 -6px 16px rgba(0,0,0,.08);display:flex;flex-direction:column;pointer-events:auto;animation:drwUp .2s ease}
@keyframes drwUp{from{transform:translateY(24px);opacity:.7}to{transform:none;opacity:1}}
.drw-resize{position:absolute;top:-4px;left:0;right:0;height:8px;cursor:row-resize;z-index:2}
.drw-resize::after{content:"";display:block;width:48px;height:4px;border-radius:2px;background:var(--colorFill);margin:2px auto 0}
.drw-head{display:flex;align-items:center;gap:12px;padding:10px 16px;min-height:44px}
.drw-title{font-size:14px;font-weight:600;color:var(--colorTextHeading);white-space:nowrap}
.drw-head .x{margin-left:auto;cursor:pointer;color:var(--colorIcon);display:inline-flex;padding:4px;border-radius:4px}
.drw-head .x:hover{background:var(--colorBgTextHover);color:var(--colorText)}
.drw-tabs{display:flex;padding:0 16px;border-bottom:1px solid var(--colorBorderSecondary)}
.drw-tabs button{margin:0 20px -1px 0}
.drw-body{flex:1;overflow:auto;padding:12px 16px 16px}
.drw-find{display:flex;align-items:center;gap:8px;margin:0 0 8px;flex-wrap:wrap}
/* фильтр-чипы в стиле ad-hoc фильтров Superset: "Статус = …", множественный выбор */
.drw-fchip{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px;border:1px solid var(--colorBorder);border-radius:var(--borderRadiusSM);background:var(--colorBgContainer);color:var(--colorText);font-size:12px;cursor:pointer}
.drw-fchip:hover{border-color:var(--colorPrimaryBorderHover)}
.drw-fchip b{font-weight:400;color:var(--colorTextSecondary)}
.drw-fchip.on{background:var(--colorPrimaryBg);border-color:var(--colorPrimary);color:var(--colorPrimary)}
.drw-fchip.on b{color:var(--colorPrimary)}
.drw-fchip.on a{cursor:pointer;color:var(--colorPrimaryTextActive);font-size:14px;line-height:1}
/* статус строки в таблице */
.schip{display:inline-block;height:20px;line-height:20px;padding:0 8px;border-radius:10px;font-size:12px;white-space:nowrap}
.schip.ok{background:var(--colorSuccessBg);color:var(--colorSuccessTextActive)}
.schip.un{background:var(--colorFillSecondary);color:var(--colorTextSecondary)}
.schip.disp{background:var(--colorWarningBg);color:var(--colorWarningTextActive)}
.schip.conf{background:var(--colorErrorBg);color:var(--colorErrorText)}
.drw-body .rtab th,.drw-body .rtab td{padding:8px;font-size:14px;line-height:22px}
.drw-body .rtab th{font-weight:600;color:var(--colorTextHeading);background:var(--colorFillAlter-solid);white-space:normal}
.drw-body .rtab td{color:var(--colorText)}
.drw-body .rtab tbody tr:hover td{background:var(--colorFillAlter-solid)}
</style></head>
