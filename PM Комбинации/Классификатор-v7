.pfield .sinput::before{background:var(--colorTextTertiary);-webkit-mask:var(--ic-search) no-repeat center/contain;mask:var(--ic-search) no-repeat center/contain;width:14px;height:14px}
.dsel,.msel{border-color:var(--colorBorder);border-radius:var(--borderRadius)}
.dsel:hover,.msel:hover{border-color:var(--colorPrimaryHover)}
.dsel::after,.msel::after{content:"";width:10px;height:10px;font-size:0;background:var(--colorTextQuaternary);-webkit-mask:var(--ic-down) no-repeat center/contain;mask:var(--ic-down) no-repeat center/contain;top:50%;transform:translateY(-50%)}
.msel-pop{border-color:var(--colorBorder)}
