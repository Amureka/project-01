.bdg{display:inline-block;height:22px;padding:0 8px;border:1px solid var(--colorBorderSecondary);border-radius:var(--borderRadiusSM);background:var(--colorFillAlter-solid);color:var(--colorText);font-size:12px;font-weight:400;line-height:20px;white-space:nowrap}
