function evalRow(r,rows){const hit=[];[...new Set(rows.map(x=>x.no))].forEach(no=>{const rr=rows.filter(x=>x.no===no);if(rr.some(x=>!(x.op||x.opText)||!x.col||!x.o||(!String(x.v).trim()&&!['пусто','не пусто'].includes(x.o))))return;if(rr.every(x=>condOk(r,x)))hit.push(no);});
  if(!hit.length)return {all:[],win:null,conf:false,top:[]};const pr=no=>{const p=rows.find(x=>x.no===no).pr;return p===''||p==null?-1e9:+p;},op=no=>opKey(rows.find(x=>x.no===no));const mx=Math.max(...hit.map(pr));const top=hit.filter(n=>pr(n)===mx);const conf=new Set(top.map(op)).size>1;return {all:hit,win:conf?null:Math.min(...top),conf,top};}
function condOk(r,x){const t=x.t||CT[x.col],val=String(r[x.col]==null?'':r[x.col]),vs=splitVals(x.v).map(s=>nz(s)).filter(Boolean),c=nz(val);
  if(x.o==='пусто')return !val;if(x.o==='не пусто')return !!val;
  if(t!=='string'){const k=s=>t==='number'?+s:dkey(s);const a=k(val);const b=k(vs[0]);return {'равно':a===b,'не равно':a!==b,'больше':a>b,'больше или равно':a>=b,'меньше':a<b,'меньше или равно':a<=b}[x.o];}
  const any=f=>vs.some(f);switch(x.o){case 'равно':return any(v=>c===v);case 'не равно':return !any(v=>c===v);case 'содержит':return any(v=>c.includes(v));case 'не содержит':return !any(v=>c.includes(v));case 'начинается с':return any(v=>c.startsWith(v));case 'не начинается с':return !any(v=>c.startsWith(v));case 'заканчивается на':return any(v=>c.endsWith(v));case 'не заканчивается на':return !any(v=>c.endsWith(v));}return false;}
