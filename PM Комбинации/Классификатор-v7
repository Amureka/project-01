  h+=`<div class="panel-head verhead"><div class="vleft"><span class="ptitle">Версия ${c.appr+1}</span><span class="bdg">Правил ${nr}</span><span class="bdg">Условий ${ST.rows.length}</span>${errB}</div></div>`;
