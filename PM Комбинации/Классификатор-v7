/* =====================================================================
   Superset 6 / Ant Design v5 layer
   Все цвета - токены из файла Tokens (--color*). Производные помечены.
   ===================================================================== */
html{color-scheme:light}
body{
  font-family:"SB Sans Interface",sans-serif;
  font-size:14px;line-height:1.5714;color:var(--colorText);background:var(--colorBgLayout);
  -webkit-font-smoothing:antialiased;
}
a{color:var(--colorLink)}
a:hover{color:var(--colorPrimaryActive)}
.lnk{color:var(--colorLink)}
*::selection{background:var(--colorPrimaryBgHover)}
:focus-visible{outline:2px solid var(--colorPrimaryBorder);outline-offset:1px}
input[type=checkbox],input[type=radio]{accent-color:var(--colorPrimary)}

/* scrollbars как в Superset Table */
*{scrollbar-width:thin;scrollbar-color:var(--colorFillSecondary) var(--colorFillQuaternary)}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-track{background:var(--colorFillQuaternary)}
::-webkit-scrollbar-thumb{background:var(--colorFillSecondary);border-radius:2px}
::-webkit-scrollbar-thumb:hover{background:var(--colorFill-solid)}

/* ---------- иконки antd ---------- */
.anticon{display:inline-flex;align-items:center;justify-content:center;line-height:0;vertical-align:-.125em;color:inherit}
.anticon svg{display:block;fill:currentColor}

/* ---------- шапка Superset ---------- */
.topnav{height:48px;padding:0 16px;gap:0;background:var(--colorBgContainer);border-bottom:1px solid var(--colorBorderSecondary);box-shadow:none}
.topnav .logo{height:100%;padding:0 16px 0 0;gap:8px;font-size:16px;font-weight:400;color:var(--colorText)}
.topnav .logo i{width:20px;height:20px;border-radius:50%;background:conic-gradient(from 20deg,var(--colorPrimary),var(--colorSuccess),var(--colorPrimary))}
.topnav .logo + nav{border-left:1px solid var(--colorBorderSecondary);margin-left:0;padding-left:0}
.topnav nav{gap:0;height:100%;align-items:stretch}
.topnav nav a{position:relative;display:flex;align-items:center;gap:8px;height:100%;padding:0 16px;border-radius:0;background:none;color:var(--colorText);font-weight:400;font-size:14px}
.topnav nav a .anticon{color:var(--colorIcon);font-size:8px}
.topnav nav a svg{fill:currentColor;stroke:none;width:8px;height:8px;margin:0;vertical-align:baseline}
.topnav nav a::after{content:"";position:absolute;left:1%;right:1%;bottom:0;height:2px;background:var(--colorPrimaryBorderHover);transform:scale(0);transition:all .2s ease-out}
.topnav nav a:hover{background:none;color:var(--colorPrimary)}
.topnav nav a:hover::after,.topnav nav a.active::after{transform:scale(1)}
.topnav nav a.active{background:none;color:var(--colorPrimary);font-weight:400}
.nav-right{gap:0;height:100%;color:var(--colorText)}
.nav-right>span{display:inline-flex;align-items:center;gap:8px;height:100%;padding:0 12px;cursor:pointer;color:var(--colorText)}
.nav-right>span:hover{color:var(--colorPrimary)}
.nav-right .anticon.caret{font-size:8px;color:var(--colorIcon)}
.nav-right .plus{width:auto;height:100%;border:0;border-radius:0;font-size:inherit}
.avatar{width:32px;height:32px;margin-left:4px;background:var(--colorPrimaryBgHover);color:var(--colorPrimaryTextActive);font-size:12px}
.bell i{background:var(--colorError);color:var(--colorWhite)}

/* ---------- страница ---------- */
.page{padding:16px 24px 32px}
.crumbs{color:var(--colorTextSecondary);font-size:14px;margin-bottom:8px;align-items:center}
.crumbs>span{color:var(--colorTextTertiary)}
h1{font-size:20px;font-weight:600;line-height:1.4;color:var(--colorTextHeading)}
.meta,.meta .muted{color:var(--colorTextSecondary);font-size:14px}
.muted{color:var(--colorTextSecondary);font-size:12px}
.page-head{margin-bottom:16px}
.status-line{color:var(--colorTextSecondary);font-size:14px}

/* ---------- Tabs (antd line) ---------- */
.sec-tabs{gap:32px;margin:0 0 16px;border-bottom:1px solid var(--colorBorderSecondary)}
.tabs-row{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:0;border-bottom:1px solid var(--colorBorderSecondary)}
.tabs-row .sec-tabs{margin:0;border-bottom:0;flex:1;min-width:0}
.tabs-row .actions{margin-bottom:8px}
.sec-tabs a{padding:12px 0;margin:0 0 -1px;color:var(--colorText);font-weight:400;border-bottom:2px solid transparent;transition:color .2s}
.sec-tabs a:hover{color:var(--colorPrimaryHover)}
.sec-tabs a.on{color:var(--colorPrimary);border-bottom-color:var(--colorPrimary)}
.tabs{gap:32px;align-self:stretch}
.tabs button{padding:12px 0;margin:0 0 -8px;color:var(--colorText);font-weight:400}
.tabs button:hover{color:var(--colorPrimaryHover)}
.tabs button.on{color:var(--colorPrimary);border-bottom-color:var(--colorPrimary)}
.panel-head{padding:0 16px;min-height:46px}

/* ---------- Button (Superset: высота 32, 12px / 600, secondary по умолчанию) ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 16px;border:1px solid transparent;border-radius:4px;
  background:var(--colorPrimaryBg);color:var(--colorPrimary);font:inherit;font-size:12px;font-weight:600;line-height:1;transition:background-color .2s,color .2s,border-color .2s}
.btn:hover{background:var(--colorPrimaryBgHover);color:var(--colorPrimary)}
.btn:active{background:var(--colorPrimaryBorder)}
.btn.primary{background:var(--colorPrimary);color:var(--colorTextLightSolid)}
.btn.primary:hover{background:var(--colorPrimaryHover);color:var(--colorTextLightSolid)}
.btn.primary:active{background:var(--colorPrimaryActive)}
.btn.danger{background:var(--colorError);color:var(--colorTextLightSolid)}
.btn.danger:hover{background:var(--colorErrorHover);color:var(--colorTextLightSolid)}
.btn.danger:active{background:var(--colorErrorActive)}
.btn.sm{height:30px;padding:0 8px;font-size:12px;border-radius:4px}
.btn.icon{width:32px;padding:0;font-size:12px}
.btn.on{background:var(--colorPrimaryBgHover);border-color:transparent;color:var(--colorPrimary)}
.btn:disabled,.btn[disabled]{background:var(--colorBgContainerDisabled-solid)!important;color:var(--colorTextDisabled)!important;border-color:var(--colorBorder);cursor:not-allowed;opacity:1}
.btn .anticon{font-size:14px}

/* ---------- Input / Select (antd) ---------- */
html body :is(input:not([type=checkbox]):not([type=radio]):not(.err):not(.ferr):not(.ss-in),select:not(.err):not(.ferr),textarea){
  border:1px solid var(--colorBorder);border-radius:var(--borderRadius);background-color:var(--colorBgContainer);color:var(--colorText);transition:border-color .2s,box-shadow .2s}
