/* ---------- antd Select / AutoComplete dropdown ---------- */
select.ant-open{border-color:var(--colorPrimary)!important;box-shadow:0 0 0 2px var(--colorPrimaryOutline-d)}
.ant-dd{position:fixed;z-index:1100;box-sizing:border-box;max-height:256px;max-width:480px;overflow:auto;padding:4px;background:var(--colorBgElevated);border-radius:var(--borderRadiusLG);font-size:14px;line-height:1.5714;
  box-shadow:0 6px 16px 0 rgba(0,0,0,.08),0 3px 6px -4px rgba(0,0,0,.12),0 9px 28px 8px rgba(0,0,0,.05)}
.ant-dd-item{display:flex;align-items:center;min-height:32px;padding:4px 12px;border-radius:var(--borderRadiusSM);color:var(--colorText);cursor:pointer;word-break:break-word;transition:background .2s}
