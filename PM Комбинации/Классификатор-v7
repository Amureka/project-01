/* ---------- проверка, утверждение, версии ---------- */
function runCheck(){if(ST.edit){notify('Сначала сохраните или отмените правку','danger');return;}if(!ST.rows.length){notify('Добавьте хотя бы одно правило','danger');return;}
  const FL0=checkFlags(ST.rows),pm=[];
  if(FL0.skip.size)pm.push(`заполнены не все поля в правилах ${[...FL0.skip].join(', ')}`);
  if(FL0.empty.size)pm.push(`не задан приоритет в правилах ${[...FL0.empty].join(', ')}`);
  if(FL0.conf.size)pm.push(`одинаковый приоритет при разных операциях в правилах ${[...new Set(FL0.conf.keys())].sort((x,y)=>x-y).join(', ')}`);
  if(pm.length){ST.errNos=new Set([...FL0.skip,...FL0.empty,...FL0.conf.keys()].map(n=>+n));renderRules();notify('Проверка не запущена: '+pm.join('; ')+'. Исправьте ошибки в правилах и попробуйте снова.','danger');return;}
  ST.checking=true;renderCard();
  setTimeout(()=>{ST.checking=false;ST.checked=true;ST.stale=false;ST.c.stale=false;ST.c.last={dt:'22.10.2026 15:40',pct:ST.c.id===1?74:63};const FLc=checkFlags(ST.rows);ST._chkNote=FLc.empty.size||FLc.conf.size||FLc.skip.size;renderCard();ST._chkNote?notify('Проверка завершена, есть замечания по правилам - они подсвечены в таблице','warning'):toast('Проверка завершена');},2500);}
function openBell(e){showMenu(e,BELL.length?BELL:[{t:'Новых уведомлений нет',fn:'',cls:'mhead'}]);$('#bell-n').classList.remove('on');}
