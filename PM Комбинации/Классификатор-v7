.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.chart{background:var(--colorWhite);border:1px solid var(--gray-l2);border-radius:6px;padding:8px 16px}.chart .ch{font-weight:600;font-size:14px;margin-bottom:8px}.chart .big{font-size:24px;font-weight:600;color:var(--colorText)}.chart .big small{font-size:14px;font-weight:400;color:var(--gray);margin-left:8px}.chart.ok .big{color:var(--colorSuccessActive)}.chart.warn .big,.chart.warn .ch{color:var(--colorWarningActive)}
