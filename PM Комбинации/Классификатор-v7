   :ST.rows.length?`${ES('Ничего не нашлось','Попробуйте изменить запрос.')}`:`${ES('Правил пока нет','Задайте фильтры во вкладке «Данные датасета» и нажмите «Создать правило»'+(c.lockedBy?'':', или добавьте правило вручную в режиме правки')+'.')}`;
