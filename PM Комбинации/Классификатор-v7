/* ---------- создание правила по фильтрам ---------- */
const condKey=x=>`${x.col}|${x.o}|${String(x.v).split(',').map(t=>norm(t)).filter(Boolean).sort().join(',')}`;
function ruleSets(rows){const m={};rows.forEach(r=>{(m[r.no]=m[r.no]||{no:r.no,op:opKey(r),pr:r.pr,keys:new Set()}).keys.add(condKey(r));});return Object.values(m);}
