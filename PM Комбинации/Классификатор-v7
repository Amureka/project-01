/* поле «Значение»: один инпут как в Superset — поиск, подсказки, несколько значений через запятую */
function msHtml(scope,k,v,listId,ph,dis){
  if(dis)return '<input disabled placeholder="значение не требуется" title="значение не требуется">';
  return '<input class="msv" data-ms="'+scope+k+'" data-list="'+(listId||'')+'" value="'+esc(v)+'" placeholder="'+esc(ph)+'" autocomplete="off" oninput="msTyp(this,\''+scope+'\','+k+')" onchange="msCommit(this,\''+scope+'\','+k+')" onfocus="msOpen(this,\''+scope+'\','+k+')" onkeydown="if(event.key===\'Enter\'){event.preventDefault();this.blur();}else if(event.key===\'Escape\'){msClose();}">';
}
function msTyp(inp,scope,k){({d:ST.dflt,r:ST.flt})[scope][k].v=inp.value;msOpen(inp,scope,k);}
function msCommit(inp,scope,k){msSet(scope,k,inp.value);}
function msLastSeg(v){var i=v.lastIndexOf(',');return i<0?v:v.slice(i+1);}
function msOptsFrom(listId){var dl=listId&&document.getElementById(listId);if(!dl)return[];return Array.prototype.map.call(dl.options,function(o){return o.value;});}
var MSPOP=null,MSCUR=null;
function msClose(){if(MSPOP){MSPOP.remove();MSPOP=null;}MSCUR=null;}
function msOpen(inp,scope,k){
  msClose();
  var opts=msOptsFrom(inp.dataset.list);
  var q=msLastSeg(inp.value).trim().toLowerCase();
  var tags=msTags(inp.value).map(function(t){return t.toLowerCase();});
  var rows=opts.filter(function(o){return !q||o.toLowerCase().indexOf(q)>=0;});
  if(!rows.length)return;
  MSPOP=document.createElement('div');MSPOP.className='ant-dd ms-dd';MSPOP.setAttribute('role','listbox');
  rows.slice(0,200).forEach(function(o){
    var sel=tags.indexOf(o.toLowerCase())>=0;
    var d=document.createElement('div');
    d.className='ant-dd-item ms-item'+(sel?' sel':'');d.setAttribute('role','option');d.setAttribute('aria-selected',sel?'true':'false');
    d.innerHTML='<span class="ms-check">'+(sel?'\u2713':'')+'</span><span class="ms-txt"></span>';
    d.querySelector('.ms-txt').textContent=o;
    d.addEventListener('mousedown',function(ev){
      ev.preventDefault();
      var i=inp.value.lastIndexOf(',');
      var list=msTags((i<0?'':inp.value.slice(0,i))+','+o).filter(function(t,idx,a){return a.findIndex(function(x){return norm(x)===norm(t);})===idx;});
      msClose();msSet(scope,k,msJoin(list));
      var el=document.querySelector('.msv[data-ms="'+scope+k+'"]');
      if(el){el.focus({preventScroll:true});var n=el.value.length;try{el.setSelectionRange(n,n);}catch(e){}}
    });
    MSPOP.appendChild(d);
  });
  document.body.appendChild(MSPOP);
  var r=inp.getBoundingClientRect();
  MSPOP.style.minWidth=r.width+'px';MSPOP.style.left=r.left+'px';MSPOP.style.top=(r.bottom+4)+'px';
  var h=MSPOP.offsetHeight;
  if(r.bottom+4+h>innerHeight-8&&r.top>h+12)MSPOP.style.top=(r.top-4-h)+'px';
  MSCUR={inp:inp};
}
document.addEventListener('mousedown',function(e){
  if(MSPOP&&!MSPOP.contains(e.target)&&!(MSCUR&&MSCUR.inp&&MSCUR.inp.contains(e.target)))msClose();
},true);
document.addEventListener('scroll',function(e){if(MSPOP&&!MSPOP.contains(e.target))msClose();},true);
window.addEventListener('resize',function(){if(MSPOP)msClose();});
function domChipsHtml(){return H.cdoms.map(function(d){return '<span class="mtag">'+esc(d)+'<a onclick="event.stopPropagation();domToggle(\''+d+'\',false)">&times;</a></span>';}).join('')||'<span class="ms-ph">Выберите из списка</span>';}
var DOMPOP=null,DOM_BOUND=false;
function domMsOpen(e){
  if(e){if(e.target&&e.target.tagName==='A')return;e.preventDefault();e.stopPropagation();}
  if(DOMPOP){domMsClose();return;}
  if(H.cedit)return;
  var box=document.getElementById('cat-dom');if(!box)return;
  DOMPOP=document.createElement('div');DOMPOP.className='ant-dd ms-dd';DOMPOP.setAttribute('role','listbox');
  MY_DOMAINS.forEach(function(d){
    var sel=H.cdoms.includes(d);
    var el=document.createElement('div');
    el.className='ant-dd-item ms-item'+(sel?' sel':'');el.setAttribute('role','option');el.setAttribute('aria-selected',sel?'true':'false');
    el.innerHTML='<span class="ms-check">'+(sel?'\u2713':'')+'</span><span class="ms-txt"></span>';
    el.querySelector('.ms-txt').textContent=d;
    el.addEventListener('mousedown',function(ev){ev.preventDefault();domToggle(d,!sel);domMsClose();domMsOpen();});
    DOMPOP.appendChild(el);
  });
  document.body.appendChild(DOMPOP);
  var r=box.getBoundingClientRect();
  DOMPOP.style.minWidth=r.width+'px';DOMPOP.style.left=r.left+'px';DOMPOP.style.top=(r.bottom+4)+'px';
  box.classList.add('msel-open');
  if(!DOM_BOUND){DOM_BOUND=true;document.addEventListener('mousedown',function(ev){if(DOMPOP&&!DOMPOP.contains(ev.target)&&!(ev.target.closest&&ev.target.closest('#cat-dom')))domMsClose();},true);}
}
function domMsClose(){if(DOMPOP){DOMPOP.remove();DOMPOP=null;}var box=document.getElementById('cat-dom');if(box)box.classList.remove('msel-open');}
/* мультиселекты фильтров каталога «Процессы ARIS» и «Классификаторы»: попап с чекбоксами (структура — SR К-18) */
var MSFPOP=null,MSF_KIND=null,MSF_BOUND=false;
const msfSel=k=>k==='fa'?H.cfa:H.cfc;
function msfItems(k){if(k==='fa')return ARIS.map(p=>({id:p.id,html:'<b>'+esc(p.code)+'</b> '+esc(p.name),tip:p.code+' '+p.name}));
  return CLS.filter(c=>MY_DOMAINS.includes(c.dom)).map(c=>({id:c.id,html:esc(c.name),tip:c.name}));}
function faChipsHtml(){return H.cfa.length?H.cfa.map(id=>{const p=procOf(id);return '<span class="mtag" title="'+esc(p?arisLabel(p):'')+'">'+esc(p?p.code:'?')+'<a onclick="event.stopPropagation();msfToggle(\'fa\','+id+',false)">&times;</a></span>';}).join(''):'<span class="ms-ph">Выберите из списка</span>';}
function fcChipsHtml(){return H.cfc.length?H.cfc.map(id=>{const c=CLS.find(x=>x.id===id)||{};return '<span class="mtag" title="'+esc(c.name||'')+'"><span class="fc-n">'+esc(c.name||'')+'</span><a onclick="event.stopPropagation();msfToggle(\'fc\','+id+',false)">&times;</a></span>';}).join(''):'<span class="ms-ph">Выберите из списка</span>';}
function msfToggle(k,id,on){if(k==='fa')H.cfa=on?[...new Set([...H.cfa,id])]:H.cfa.filter(x=>x!==id);else H.cfc=on?[...new Set([...H.cfc,id])]:H.cfc.filter(x=>x!==id);renderCat();if(MSFPOP)msfRender();}
function msfRender(){if(!MSFPOP)return;const sel=msfSel(MSF_KIND),items=msfItems(MSF_KIND);
  MSFPOP.querySelector('.msf-list').innerHTML=items.map(x=>{const on=sel.includes(x.id);return '<div class="ant-dd-item ms-item'+(on?' sel':'')+'" role="option" aria-selected="'+(on?'true':'false')+'" data-id="'+x.id+'" title="'+esc(x.tip)+'"><span class="ms-check">'+(on?'\u2713':'')+'</span><span class="ms-txt">'+x.html+'</span></div>';}).join('')||'<div class="muted" style="padding:8px 12px">Ничего не нашлось</div>';
  MSFPOP.querySelectorAll('.msf-list .ant-dd-item').forEach(el=>el.addEventListener('mousedown',ev=>{ev.preventDefault();const id=+el.dataset.id;msfToggle(MSF_KIND,id,!msfSel(MSF_KIND).includes(id));}));}
function msfOpen(e,kind){if(e){if(e.target&&e.target.tagName==='A')return;e.preventDefault();e.stopPropagation();}
  if(MSFPOP&&MSF_KIND===kind){msfClose();return;}
  if(H.cedit)return;msfClose();MSF_KIND=kind;
  const box=document.getElementById(kind==='fa'?'cat-fa':'cat-fc');if(!box)return;
  MSFPOP=document.createElement('div');MSFPOP.className='ant-dd ms-dd msf-pop';MSFPOP.setAttribute('role','listbox');
  MSFPOP.innerHTML='<div class="msf-list"></div>';
  box.classList.add('msel-open');document.body.appendChild(MSFPOP);msfRender();
  const r=box.getBoundingClientRect();
  MSFPOP.style.minWidth=Math.max(r.width,260)+'px';MSFPOP.style.left=Math.max(8,Math.min(r.left,innerWidth-MSFPOP.offsetWidth-8))+'px';MSFPOP.style.top=(r.bottom+4)+'px';
  const h=MSFPOP.offsetHeight;if(r.bottom+4+h>innerHeight-8&&r.top>h+12)MSFPOP.style.top=(r.top-4-h)+'px';
  if(!MSF_BOUND){MSF_BOUND=true;document.addEventListener('mousedown',ev=>{if(MSFPOP&&!MSFPOP.contains(ev.target)&&!(ev.target.closest&&ev.target.closest('#cat-fa,#cat-fc')))msfClose();},true);}}
function msfClose(){if(MSFPOP){MSFPOP.remove();MSFPOP=null;}['cat-fa','cat-fc'].forEach(id=>{const b=document.getElementById(id);if(b)b.classList.remove('msel-open');});}
document.addEventListener('mouseover',function(e){
  var el=e.target.closest&&e.target.closest('.trunctip');
  if(!el||el.dataset.tip)return;
  if(el.scrollWidth>el.clientWidth+1){el.dataset.tip=esc(el.textContent);tipShow(el);}
});
renderHome();

</script>
<script>
/* antd-подобные Select и AutoComplete поверх нативных select / input[list] */
(function(){
  var pop=null,cur=null,act=-1;
  function closePop(){
    if(pop){pop.remove();pop=null;}
    if(cur&&cur.el&&cur.el.classList)cur.el.classList.remove('ant-open');
    cur=null;act=-1;
  }
  function place(anchor){
    var r=anchor.getBoundingClientRect();
    pop.style.minWidth=r.width+'px';pop.style.left=r.left+'px';pop.style.top=(r.bottom+4)+'px';
    var h=pop.offsetHeight,w=pop.offsetWidth;
    if(r.bottom+4+h>innerHeight-8&&r.top>h+12)pop.style.top=(r.top-4-h)+'px';
    if(r.left+w>innerWidth-8)pop.style.left=Math.max(8,innerWidth-8-w)+'px';
  }
  function setActive(i){
    var els=pop.querySelectorAll('.ant-dd-item');
    if(!els.length)return;
    act=Math.max(0,Math.min(els.length-1,i));
    els.forEach(function(e,k){e.classList.toggle('active',k===act);});
    els[act].scrollIntoView({block:'nearest'});
  }
  function build(rows,onPick,selIdx){
    pop=document.createElement('div');pop.className='ant-dd';pop.setAttribute('role','listbox');
    var n=0;
    rows.forEach(function(r){
      var d=document.createElement('div');
      if(r.g!==undefined){d.className='ant-dd-group';d.textContent=r.g;}
      else{
        d.className='ant-dd-item'+(r.sel?' sel':'')+(r.dis?' dis':'');
        d.setAttribute('role','option');d.setAttribute('aria-selected',r.sel?'true':'false');
        d.textContent=r.t||'\u00a0';d.dataset.i=n++;
        if(!r.dis)d.addEventListener('click',function(){onPick(r);});
        d.addEventListener('mousemove',function(){setActive(+d.dataset.i);});
      }
      pop.appendChild(d);
    });
    pop.addEventListener('mousedown',function(e){e.preventDefault();});
    document.body.appendChild(pop);
  }
  function fire(el,types){types.forEach(function(t){el.dispatchEvent(new Event(t,{bubbles:true}));});}

  /* ---- Select ---- */
  function openSelect(sel){
    closePop();
    var rows=[],k=0;
    function add(o){rows.push({t:o.textContent,dis:o.disabled,sel:o.selected,idx:o.index});}
    Array.prototype.forEach.call(sel.children,function(ch){
      if(ch.tagName==='OPTGROUP'){rows.push({g:ch.label});Array.prototype.forEach.call(ch.children,add);}
      else if(ch.tagName==='OPTION')add(ch);
    });
    cur={el:sel,type:'select'};sel.classList.add('ant-open');
    build(rows,function(r){sel.selectedIndex=r.idx;closePop();sel.focus();fire(sel,['input','change']);},0);
    place(sel);
    var items=pop.querySelectorAll('.ant-dd-item');
    var si=-1;items.forEach(function(e,i){if(e.classList.contains('sel'))si=i;});
    setActive(si<0?0:si);
  }
  function skip(sel){return sel.disabled||sel.multiple||sel.size>1||sel.closest('table.rules');}
  document.addEventListener('mousedown',function(e){
    var t=e.target;
    if(t.tagName==='SELECT'&&!skip(t)){
      e.preventDefault();t.focus();
      if(cur&&cur.el===t)closePop();else openSelect(t);
      return;
    }
    if(pop&&!pop.contains(t)&&!(cur&&cur.el===t))closePop();
  },true);
  document.addEventListener('keydown',function(e){
    var t=e.target;
    if(pop){
      if(e.key==='Escape'){closePop();return;}
      if(cur&&cur.type==='select'||(cur&&cur.type==='ac')){
        if(e.key==='ArrowDown'){e.preventDefault();setActive(act+1);return;}
        if(e.key==='ArrowUp'){e.preventDefault();setActive(act-1);return;}
        if(e.key==='Enter'&&act>=0){var el=pop.querySelectorAll('.ant-dd-item')[act];if(el){e.preventDefault();el.click();}return;}
        if(e.key==='Tab'){closePop();}
      }
      return;
    }
    if(t.tagName==='SELECT'&&!skip(t)&&(e.key==='Enter'||e.key===' '||(e.altKey&&e.key==='ArrowDown'))){
      e.preventDefault();openSelect(t);
    }
  },true);
  window.addEventListener('resize',closePop);
  document.addEventListener('scroll',function(e){if(pop&&!pop.contains(e.target))closePop();},true);

  /* ---- AutoComplete (вместо нативного datalist) ---- */
  function acOptions(inp){
    var dl=document.getElementById(inp.dataset.list),out=[];
    if(!dl)return out;
    Array.prototype.forEach.call(dl.options,function(o){out.push(o.value);});
    return out;
  }
  function showAc(inp){
    if(inp.disabled||inp.readOnly)return;
    var q=inp.value.trim().toLowerCase();
    var vals=acOptions(inp).filter(function(v){return !q||v.toLowerCase().indexOf(q)>=0;});
    if(vals.length===1&&vals[0].toLowerCase()===q)vals=[];
    vals=vals.slice(0,50);
    if(!vals.length){if(cur&&cur.el===inp)closePop();return;}
    closePop();
    cur={el:inp,type:'ac'};
    build(vals.map(function(v){return {t:v,sel:v===inp.value};}),function(r){inp.value=r.t;closePop();fire(inp,['input','change']);},0);
    place(inp);setActive(-1);act=-1;
  }
  function convertTitles(){
    Array.prototype.forEach.call(document.querySelectorAll('[title]'),function(el){
      var t=el.getAttribute('title');if(!t||el.tagName==='TITLE'||el.closest('svg'))return;
      var tip=t.replace(/&/g,'&amp;').replace(/</g,'&lt;');el.removeAttribute('title');
      if(el.disabled&&el.parentNode){var w=document.createElement('span');w.className='tip-wrap';w.dataset.tip=tip;el.parentNode.insertBefore(w,el);w.appendChild(el);}
      else if(!el.dataset.tip)el.dataset.tip=tip;
    });
  }
  function convert(){
    convertTitles();
    Array.prototype.forEach.call(document.querySelectorAll('input[list]'),function(i){
      i.dataset.list=i.getAttribute('list');i.removeAttribute('list');i.setAttribute('autocomplete','off');
    });
    Array.prototype.forEach.call(document.querySelectorAll('.fpanel .fbody'),function(fb){
      if(fb.querySelector('.add-filter'))return;
      var src=fb.querySelector('.frow .ico[title="Добавить фильтр"]');if(!src)return;
      var bt=document.createElement('button');bt.type='button';bt.className='add-filter';
      bt.innerHTML='<span class=\"anticon\" role=\"img\" aria-label=\"plus\"><svg viewBox=\"0 0 1024 1024\" width=\"14\" height=\"14\" fill=\"currentColor\" focusable=\"false\" aria-hidden=\"true\"><path d=\"M482 152h60q8 0 8 8v704q0 8-8 8h-60q-8 0-8-8V160q0-8 8-8Z\"/><path d=\"M192 474h672q8 0 8 8v60q0 8-8 8H160q-8 0-8-8v-60q0-8 8-8Z\"/></svg></span><span>Добавить фильтр</span>';
      bt.addEventListener('click',function(){src.click();});
      fb.appendChild(bt);
    });
    Array.prototype.forEach.call(document.querySelectorAll('.frow .ico'),function(a){
      if(!a.hasAttribute('role')){a.setAttribute('role','button');a.setAttribute('tabindex','0');
        a.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();a.click();}});}
    });
  }
  document.addEventListener('focusin',function(e){if(e.target.dataset&&e.target.dataset.list)showAc(e.target);});
  document.addEventListener('input',function(e){if(e.target.dataset&&e.target.dataset.list)showAc(e.target);});
  document.addEventListener('mousedown',function(e){var t=e.target;if(t.dataset&&t.dataset.list&&document.activeElement===t&&!pop)showAc(t);});
  new MutationObserver(function(){convert();if(cur&&!document.body.contains(cur.el))closePop();}).observe(document.body,{childList:true,subtree:true});
  convert();
})();

</script>
