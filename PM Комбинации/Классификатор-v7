.ed-reopen{background:var(--colorBgContainer);border-color:var(--colorBorderSecondary);color:var(--colorPrimary);box-shadow:var(--shadow-sm)}
.osh,.ph b{color:var(--colorTextHeading)}

/* ---------- Modal (Superset / antd) ---------- */
.mbg{background:var(--colorBgMask);align-items:flex-start;padding:48px 16px}
.modal{border-radius:4px;background:var(--colorBgElevated);box-shadow:0 6px 16px 0 rgba(0,0,0,.08),0 3px 6px -4px rgba(0,0,0,.12),0 9px 28px 8px rgba(0,0,0,.05);color:var(--colorText)}
