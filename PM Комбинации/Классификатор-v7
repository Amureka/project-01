.toast::before{content:"";flex:none;width:16px;height:16px;background:var(--colorSuccess);-webkit-mask:var(--ic-check-circle) no-repeat center/contain;mask:var(--ic-check-circle) no-repeat center/contain}

/* ---------- прочее ---------- */
.rl span{border-color:var(--colorBorder);color:var(--colorTextSecondary)}
.rl span.win{background:var(--colorSuccessBg);border-color:var(--colorSuccessBorder);color:var(--colorSuccessActive)}
