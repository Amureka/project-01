  if(g&&t){const lo=+g.pr,hi=+t.pr,p=lo+10<hi?lo+10:Math.floor((lo+hi)/2);
    if(p<=lo||p>=hi)return {pr:'',why:`Между правилами ${g.no} (${lo}) и ${t.no} (${hi}) нет свободного приоритета - задайте его вручную или поменяйте приоритеты этих правил`};
    return {pr:p,why:`Предложено между правилами ${g.no} (${lo}) и ${t.no} (${hi}): новое правило уточняет первое и общее для второго`};}
  if(g)return {pr:+g.pr+10,why:`Предложено выше правила ${g.no} (${g.pr}): его условия входят в новое правило`};
  if(t){const p=Math.max(1,+t.pr-10);if(p>=+t.pr)return {pr:'',why:`Ниже правила ${t.no} (${t.pr}) нет свободного приоритета - задайте его вручную или поменяйте приоритет этого правила`};
