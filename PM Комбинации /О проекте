<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Классификаторы операций - макет</title>
<style>
:root{
  --primary:#5485D2; --primary-d1:#436AA8; --primary-l1:#98B6E4; --primary-l2:#BBCEED; --primary-l3:#DDE7F6; --primary-l4:#F0F4FB; --primary-l5:#F3F6FC;
  --success:#40BEA8; --success-d1:#1F8D79; --success-l1:#B4E5DC; --success-l2:#EEFAF7;
  --error:#D8404C; --error-l1:#F2C0C4; --error-l2:#FDF0F1;
  --warning:#FF832E; --warning-d1:#C8601A; --warning-l1:#FFC197; --warning-l2:#FFF3EA;
  --info-l2:#EFF8FE;
  --slate:#63727C; --slate-l2:#F1F3F5;
  --gray:#64666B; --gray-d1:#303237; --gray-l1:#ABAEB9; --gray-l2:#E1E6F3; --gray-l3:#EEF0F5; --gray-l4:#F5F7FC;
  --label:#8A8C91; --link:#436AA8; --r:4px;
  --bg:#F5F7FC; --surface:#FFFFFF; --text:#303237;
  color-scheme:light;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ --bg:#F5F7FC; --surface:#FFFFFF; --text:#303237; } }
:root[data-theme="dark"]{ --bg:#F5F7FC; --surface:#FFFFFF; --text:#303237; }
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:13px/1.45 "SB Sans Interface","SBSansInterfaceRegular",Inter,"Segoe UI",Roboto,system-ui,sans-serif}
a{color:var(--link);cursor:pointer;text-decoration:none}
b{font-weight:600}
.scroller{overflow-x:auto}
.frame{min-width:1220px;min-height:100vh}

.topnav{height:48px;background:var(--surface);border-bottom:1px solid var(--gray-l2);display:flex;align-items:center;padding:0 16px;gap:24px;position:sticky;top:env(safe-area-inset-top,0px);z-index:20}
.logo{display:flex;align-items:center;gap:8px;font-weight:600;white-space:nowrap}
.logo i{width:18px;height:18px;border-radius:50%;background:conic-gradient(from 20deg,var(--primary),var(--success),var(--primary))}
.topnav nav{display:flex;gap:2px}
.topnav nav a{padding:6px 10px;border-radius:var(--r);color:var(--gray);white-space:nowrap}
.topnav nav a:hover{background:var(--gray-l3)}
.topnav nav a.active{color:var(--primary-d1);background:var(--primary-l4);font-weight:600}
.nav-right{margin-left:auto;display:flex;align-items:center;gap:16px;color:var(--gray);white-space:nowrap}
.nav-right .plus{width:26px;height:26px;border:1px solid var(--gray-l2);border-radius:var(--r);display:flex;align-items:center;justify-content:center;font-size:16px}
.avatar{width:28px;height:28px;border-radius:50%;background:var(--primary-l3);color:var(--primary-d1);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600}

.screen{display:none}.screen.on{display:block}
.page{padding:14px 24px 32px;display:flex;flex-direction:column;min-height:calc(100vh - 48px)}
.crumbs{color:var(--gray);font-size:12px;margin-bottom:6px;display:flex;gap:8px}
.page-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:10px}
h1{margin:0 0 4px;font-size:20px;font-weight:600;line-height:1.3}
.h1row{display:flex;align-items:center;gap:12px;margin-bottom:2px}
.h1row h1{margin:0}
.topnav nav a svg{width:14px;height:14px;vertical-align:-2px;margin-right:6px;fill:none;stroke:currentColor;stroke-width:1.8}
.meta{display:flex;flex-wrap:wrap;gap:6px 18px;color:var(--gray);font-size:12px;align-items:center}
.actions{display:flex;gap:8px;align-items:center;flex-shrink:0}
.toolbar{display:flex;gap:8px;margin-bottom:12px;align-items:center}
.toolbar input,.toolbar select{height:32px;border:1px solid var(--gray-l2);border-radius:var(--r);padding:0 10px;font:inherit;background:var(--surface);color:var(--text)}
.toolbar input{width:280px}
.panel{background:var(--surface);border:1px solid var(--gray-l2);border-radius:var(--r)}
.panel-head{display:flex;align-items:center;justify-content:space-between;padding:6px 10px;border-bottom:1px solid var(--gray-l2);min-height:40px}
.panel-head .right{display:flex;gap:10px;align-items:center}
.muted{color:var(--gray);font-size:12px}

.btn{height:34px;padding:0 16px;border-radius:4px;border:0;background:#EEF3FB;color:#436AA8;font:inherit;font-size:14px;cursor:pointer;white-space:nowrap}
.btn:hover{background:#E1EAF8}
.btn.primary{background:#5485D2;color:#fff}
.btn.primary:hover{background:#4774BF}
.btn.sm{height:28px;padding:0 10px;font-size:13px}
.btn.icon{width:34px;padding:0;font-size:16px}
.btn.on{background:var(--primary-l4);border-color:var(--primary-l2);color:var(--primary-d1)}
.btn.danger{background:var(--error);color:#fff}.btn.danger:hover{background:#B8323D}
.btn:disabled{opacity:.45;cursor:default;border-color:var(--gray-l2)}
.btn:focus-visible,.tabs button:focus-visible,.seg button:focus-visible{outline:2px solid var(--primary-l1);outline-offset:1px}
.chip{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:11px;font-size:12px;font-weight:600;white-space:nowrap}
.chip.draft{background:var(--slate-l2);color:var(--slate)}
.chip.ok{background:var(--success-l2);color:var(--success-d1)}
.chip.ver{background:var(--primary-l4);color:var(--primary-d1)}
.seg{display:inline-flex;border:1px solid var(--gray-l2);border-radius:var(--r);overflow:hidden}
.seg button{border:0;background:var(--surface);padding:4px 10px;font:inherit;font-size:12px;color:var(--gray);cursor:pointer}
.seg button.on{background:var(--primary-l4);color:var(--primary-d1);font-weight:600}
.seg button:disabled{color:var(--gray-l1);cursor:default}
.tabs{display:flex}
.tabs button{border:0;background:transparent;padding:9px 10px;font:inherit;color:var(--gray);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-7px}
.tabs button.on{color:var(--primary-d1);border-bottom-color:var(--primary);font-weight:600}
.badge{background:var(--warning-l2);color:var(--warning-d1);border-radius:9px;padding:0 6px;font-size:11px;margin-left:4px;font-weight:600}

table{border-collapse:collapse;width:100%}
th{text-align:left;font-size:12px;color:var(--gray);font-weight:600;background:var(--gray-l4);padding:8px 12px;border-bottom:1px solid var(--gray-l2);white-space:nowrap}
td{padding:8px 12px;border-bottom:1px solid var(--gray-l3);vertical-align:middle}
tr.row{cursor:pointer}
tr.row:hover td{background:var(--primary-l5)}
.num{text-align:right;font-variant-numeric:tabular-nums}
.list a.name{font-weight:600}
td.ic{width:96px;white-space:nowrap;text-align:right}
td.ic a{opacity:0;margin-left:10px;color:var(--gray);font-size:15px;transition:opacity .1s}
tr:hover td.ic a{opacity:1}
td.ic a:hover{color:var(--text)}

.status-line{display:flex;align-items:center;gap:14px;margin:2px 0 12px;color:var(--gray);font-size:13px;flex-wrap:wrap;min-height:20px}
.status-line .bar.run i{animation:fill 2.2s linear forwards;background:var(--primary)}
.status-line .bar{width:180px;height:6px;background:var(--gray-l3);border-radius:3px;overflow:hidden}
.status-line .bar i{display:block;height:100%;background:var(--success)}
.status-line b{color:var(--text)}
.status-line .warn b{color:var(--warning-d1)}
.status-line span[title]{border-bottom:1px dotted var(--gray-l1);cursor:help}

/* rules grid: admin look (glide-data-grid) */
.rules{table-layout:auto}
.rules td.c{position:relative;cursor:default;max-width:360px;overflow:hidden;text-overflow:ellipsis}
.rules td.c.sel{outline:2px solid var(--primary);outline-offset:-2px;background:var(--primary-l5)}
.rules td.c.dd::before{content:"";position:absolute;left:0;top:0;border:6px solid transparent;border-top-color:var(--error);border-left-color:var(--error)}
.rules td.c.err{background:var(--error-l2)}
.rules td.c.editing{padding:0;overflow:visible}
.rules .editor{width:100%;height:36px;border:2px solid var(--primary);border-radius:0;padding:0 6px;font:inherit;font-size:13px;background:var(--surface);color:var(--text);outline:none;box-sizing:border-box}
.rules tr.trail td{color:var(--gray-l1);cursor:pointer;font-size:12px;background:var(--surface)}
.rules tr.trail:hover td{color:var(--primary-d1);background:var(--primary-l5)}
.rules tr.rowsel td{background:var(--primary-l4)}
.fpanel{border-bottom:1px solid var(--gray-l2);font-size:13px;position:relative}
.fpanel .ftog{display:inline-block;padding:9px 12px;color:var(--text);cursor:pointer}
.fpanel .fcount{display:inline-block;min-width:18px;height:18px;border-radius:9px;background:var(--primary);color:#fff;font-size:11px;text-align:center;line-height:18px;margin-left:6px}
.fpanel .fcount:empty{display:none}
.fpanel .lastupd{position:absolute;right:12px;top:9px;color:var(--gray);font-size:12px}
.frow{display:flex;gap:8px;align-items:center;margin-bottom:6px;width:100%}
.frow select,.frow input{height:34px;border:1px solid var(--gray-l2);border-radius:var(--r);padding:0 10px;font:inherit;font-size:13px;background:var(--surface);color:var(--text);flex:1;min-width:0}
.frow .ico{width:20px;text-align:center;color:var(--gray);cursor:pointer;flex:none}
.frow .ico:hover{color:var(--text)}
.fpanel .ftog:hover{color:var(--primary-d1)}
.fpanel .fbody{display:none;padding:4px 12px 8px;max-width:1100px}
.fpanel.open .fbody{display:block}
.fpanel .fbody label{color:var(--gray)}
.fpanel .fbody input,.fpanel .fbody select{height:26px;border:1px solid var(--gray-l2);border-radius:var(--r);padding:0 6px;font:inherit;font-size:12px;background:var(--surface);color:var(--text)}
.fpanel .fbody input{width:170px}

.tbl-panel{flex:1;display:flex;flex-direction:column}
.grid-wrap{overflow:auto;flex:1;min-height:380px}
.rules th,.rules td{padding:0 10px;height:36px;border-right:1px solid var(--gray-l3);font-size:14px;white-space:nowrap}
.rules th{background:var(--surface);color:var(--gray-d1);font-weight:600;font-size:13px;border-bottom:1px solid var(--gray-l2);text-align:left;position:sticky;top:0;z-index:2}
.rules th .arr{float:right;color:var(--gray-d1);font-size:11px;margin:1px 0 0 8px}
.rules th.num{text-align:right}
.rules tr.r td{border-bottom:1px solid var(--gray-l3)}
.rules tr.first td{border-top:1px solid var(--gray-l2)}
.rules tr.selrule td{background:var(--primary-l5)}
.rules td.rep{color:var(--gray-l1)}
.rules td.join{text-align:center;color:var(--gray);font-weight:600;font-size:12px}
.rules td.cnt{text-align:right;font-variant-numeric:tabular-nums}
.rules td.cnt.ov{color:var(--warning-d1);font-weight:600}
.rules td.cnt.zero{color:var(--gray-l1)}
.rules td.complex{color:var(--gray);font-style:italic}
.rules td.complex a{font-style:normal;margin-left:6px}
.rules td.w0{width:22px;padding:0;text-align:center;color:var(--gray-l1);cursor:grab;letter-spacing:-2px}
.rules td.rowact{width:40px;text-align:center}
.rules td.rowact a{color:var(--gray-l1);font-size:14px;opacity:0}
.rules tr:hover td.rowact a{opacity:1}
.rules td.rowact a:hover{color:var(--text)}
.rules tr.new td{background:var(--gray-l4)}
.rules input,.rules select{height:26px;border:1px solid var(--gray-l2);border-radius:3px;padding:0 6px;font:inherit;font-size:13px;background:var(--surface);color:var(--text);width:100%;min-width:60px}
.rules input:focus,.rules select:focus{outline:2px solid var(--primary-l1);border-color:var(--primary-l1)}
.rules input.err,.rules select.err{border-color:var(--error);background:var(--error-l2)}
.rules .w50{width:52px}.rules .w60{width:64px}.rules .w220{width:220px}
.ddl{position:relative;display:block}
.ddl::after{content:"";position:absolute;right:4px;top:3px;border:5px solid transparent;border-top:6px solid var(--error);border-right:6px solid var(--error);border-radius:1px;pointer-events:none;transform:scale(.9)}
.ddl select{appearance:none;-webkit-appearance:none;padding-right:16px}
.hints{padding:7px 10px;border-top:1px solid var(--gray-l2);color:var(--gray);font-size:12px;display:flex;gap:14px;flex-wrap:wrap}
.hints kbd{border:1px solid var(--gray-l2);border-bottom-width:2px;border-radius:3px;padding:0 5px;font:11px/16px inherit;background:var(--gray-l4)}
.empty{padding:22px 18px;color:var(--gray);background:var(--primary-l5);border-bottom:1px solid var(--gray-l2)}
.empty b{color:var(--text)}

/* sample panel */
.sample-panel{display:none;margin-top:12px;position:relative}
.sample-panel.open{display:block}
.data-body{max-height:380px;overflow:auto}
.filt{display:flex;align-items:center;gap:8px;padding:8px 10px;border-bottom:1px solid var(--gray-l3);font-size:12px;flex-wrap:wrap}
.filt .fchip{background:var(--info-l2);border:1px solid #B3DEFE;color:var(--primary-d1);border-radius:3px;padding:2px 6px;display:inline-flex;gap:6px;align-items:center}
.filt .fchip a{color:var(--gray)}
.sample td{font-size:12px;padding:6px 8px;white-space:nowrap;max-width:360px;overflow:hidden;text-overflow:ellipsis}
.sample th{padding:6px 8px}
.sample tr.hit td{background:var(--success-l2)}
.sample tr.dim td{opacity:.4}
.sample tr.picked td{box-shadow:inset 2px 0 0 var(--primary)}
.sample tr.uncov td.rc{color:var(--warning-d1);font-weight:600}
mark{background:var(--warning-l1);color:inherit;padding:0 1px;cursor:pointer;border-radius:2px}
.pop{position:absolute;left:14px;right:14px;top:90px;background:var(--surface);border:1px solid var(--primary-l2);box-shadow:0 8px 24px rgba(48,50,55,.18);border-radius:var(--r);padding:10px 12px;z-index:5;display:none}
.pop.open{display:block}
.pop .t{margin-bottom:8px}
.pop .t em{font-style:normal;background:var(--warning-l1);padding:0 3px;border-radius:2px}
.pop .b{display:flex;gap:8px;align-items:center}
.pop .b .x{margin-left:auto;color:var(--gray);cursor:pointer}
.facet .sel-col{padding:8px 10px;border-bottom:1px solid var(--gray-l3);display:flex;gap:8px;align-items:center}
.facet .sel-col select{height:28px;border:1px solid var(--gray-l2);border-radius:var(--r);font:inherit;padding:0 8px;background:var(--surface);color:var(--text)}
.facet .v{display:grid;grid-template-columns:1fr 120px 60px auto;align-items:center;gap:8px;padding:5px 10px;border-bottom:1px solid var(--gray-l3);font-size:12px}
.facet .v .name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--link);cursor:pointer}
.facet .vb{height:6px;background:var(--gray-l3);border-radius:3px;overflow:hidden}
.facet .vb i{display:block;height:100%;background:var(--primary-l1)}
.facet .pm{display:flex;gap:4px}
.facet .pm button{width:22px;height:22px;border:1px solid var(--gray-l2);background:var(--surface);border-radius:3px;cursor:pointer;font:inherit;color:var(--primary-d1)}
.facet .pm button:disabled{opacity:.35;cursor:default}
.note{padding:8px 10px;color:var(--gray);font-size:12px;border-top:1px solid var(--gray-l3)}
.rl{display:flex;gap:4px;flex-wrap:wrap}
.rl span{border:1px solid var(--gray-l2);border-radius:3px;padding:0 5px;font-size:11px;color:var(--gray)}
.rl span.win{background:var(--success-l2);border-color:var(--success-l1);color:var(--success-d1);font-weight:600}

.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:12px}
.card{background:var(--surface);border:1px solid var(--gray-l2);border-radius:var(--r);padding:12px 14px}
.card .l{color:var(--gray);font-size:12px}
.card .v{font-size:22px;font-weight:600;margin-top:2px}
.card.ok .v{color:var(--success-d1)}.card.warn .v{color:var(--warning-d1)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.panel h4{margin:0;padding:10px 12px;border-bottom:1px solid var(--gray-l2);font-size:13px;font-weight:600}

.menu{position:absolute;background:var(--surface);border:1px solid var(--gray-l2);border-radius:var(--r);box-shadow:0 8px 24px rgba(48,50,55,.18);min-width:220px;z-index:40;display:none;padding:4px 0}
.menu.open{display:block}
.cat2{display:grid;grid-template-columns:300px minmax(0,1fr);gap:12px;align-items:start}
.cat-side{padding:0;margin:0}.cs-h{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;font-weight:600;border-bottom:1px solid var(--gray-l2)}
.pit{display:flex;gap:8px;align-items:center;padding:9px 12px;border-bottom:1px solid #EEF1F6;cursor:pointer;font-size:13px}
.pit:hover{background:#F7F9FC}.pit.on{background:var(--primary-l5);box-shadow:inset 3px 0 0 var(--primary)}
.pit .kp{font-weight:600;color:var(--gray-d1);white-space:nowrap}.pit .pn{flex:1;min-width:0}.pit .cnt{color:var(--label);font-size:12px;margin-left:auto}
.pit .pact{display:none;gap:8px}.pit:hover .pact{display:inline-flex}.pit .pact a{cursor:pointer;color:var(--gray-d1)}
.pit.edit{gap:6px;flex-wrap:wrap;cursor:default;background:#FAFBFD}.pit.edit input{height:30px;flex:1;min-width:110px}
.pline{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:320px;line-height:1.5}.pline b{font-weight:600;color:var(--gray-d1);margin-right:4px}.pline.bad{color:var(--error)}
#cat-body td.procs{max-width:400px !important;min-width:300px}#cat-body td.procs .pline{max-width:380px}#cat-body td.desc{max-width:170px !important}
.pchip.bad{background:var(--error-l2);color:var(--error)}.dsel{min-width:240px;max-width:460px;height:32px;border:1px solid var(--gray-l2);border-radius:var(--r);padding:0 28px 0 10px;display:flex;align-items:center;cursor:pointer;background:var(--surface);position:relative;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-sizing:border-box}.dsel::after{content:'▾';position:absolute;right:10px;color:#9AA0A6;font-size:12px}.dsel.dis{opacity:.6;cursor:default}
.pchip{display:inline-block;background:#EEF2F8;color:#3A4A66;border-radius:10px;padding:1px 8px;font-size:12px;margin:1px 4px 1px 0;white-space:nowrap}
.cat-main{margin:0}.cat-title{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:10px 12px;min-height:50px;box-sizing:border-box;border-bottom:1px solid var(--gray-l2)}.cat-title #cat-title{flex:1;min-width:0;font-weight:600;color:var(--text);line-height:1.35}.cat-title #cat-title .kpt{color:inherit;margin-right:6px}
.cs-q{padding:10px 12px;border-bottom:1px solid #EEF1F6}
.pfield{display:flex;flex-direction:column;gap:6px;min-width:0}.pfield>label{font-size:13px;color:#64666B}
.pfield input,.pfield select{height:32px;border:1px solid var(--gray-l2);border-radius:var(--r);padding:0 10px;font:inherit;font-size:13px;background:var(--surface);color:var(--text);box-sizing:border-box;width:100%}
.pfield .sinput{position:relative}.pfield .sinput input{padding-left:32px}.pfield .sinput::before{content:'';position:absolute;left:10px;top:50%;width:15px;height:15px;transform:translateY(-50%);background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239AA0A6' stroke-width='2'><circle cx='11' cy='11' r='7'/><path d='M20 20l-4-4'/></svg>") no-repeat center/contain;pointer-events:none}
.pfield input::placeholder{color:#A9ADB4}
.pmf{display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;margin-bottom:14px}.pmf .pfield{width:280px}
.cat-sbar{padding:10px 12px;border-bottom:1px solid var(--gray-l2)}.cat-sbar .pfield{max-width:340px}
.pit.none .pn{color:var(--gray-d1);font-style:italic}.pit .newp{font-size:11px;color:#8A6D1F;background:#FFF4D6;border-radius:8px;padding:0 6px}
#cat-body tr.imp td{background:#FFFBEA}
.rules td.desc{color:var(--gray-d1);max-width:280px}
#cat-body td.c{max-width:230px}#cat-body td.desc{max-width:190px}#cat-body td.u{max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.menu .pp-i b{white-space:nowrap}#cat-body td.rowact{white-space:nowrap}
