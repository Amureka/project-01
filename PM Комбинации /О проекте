function normalizeDraft(c){const rows=RULES[c.id]||[];let ch=false;const fin=id=>{let d=DELETED.find(x=>x.id===id),n=0;while(d&&d.mode==='move'&&n++<20){id=d.to;d=DELETED.find(x=>x.id===id);}return id;};rows.forEach(r=>{const d=DELETED.find(x=>x.id===r.op);if(d&&d.mode==='move'){r.op=fin(r.op);ch=true;}});if(ch){c.approved=false;c.upd=TODAY;if(c.last)c.stale=true;}}
function doUnlock(){document.querySelectorAll('#ulk-body input').forEach(x=>{if(x.disabled||x.checked)return;if(x.dataset.id.startsWith('cat:')){const d=x.dataset.id.slice(4);if(H.cedit&&H.cdom===d)catCancel();if(CATLOCK&&CATLOCK.dom===d)CATLOCK=null;return;}const c=CLS.find(k=>k.id===+x.dataset.id);c.lockedBy=null;c.lockedAt=null;normalizeDraft(c);});closeModal('m-unlock');renderHome();toast('Блокировка снята');}
let IMC={procs:new Set(),q:''};
function renderImProcs(){const dom=$('#im-dom').value||MY_DOMAINS[0],q=IMC.q.trim().toLowerCase();const list=domAris(dom).filter(({p})=>!q||p.code.toLowerCase().includes(q)||p.name.toLowerCase().includes(q));list.sort((a,b)=>(IMC.procs.has(b.p.id)-IMC.procs.has(a.p.id))||a.p.code.localeCompare(b.p.code,'ru'));
  $('#im-procs').innerHTML=list.map(({p,n})=>`<label class="aoi"><input type="checkbox" ${IMC.procs.has(p.id)?'checked':''} onchange="if(this.checked)IMC.procs.add(${p.id});else IMC.procs.delete(${p.id});fOk('im-procs')"><span>${esc(p.code)} ${esc(p.name)}</span><span class="muted" style="margin-left:auto;white-space:nowrap">${n} ${plural(n,'операция','операции','операций')}</span></label>`).join('')||'<div class="muted" style="padding:12px">Процесс не найден</div>';}
function openImport(){IMC={procs:new Set(),q:''};$('#im-pq').value='';fClear(['im-name','im-procs']);$('#im-name').value='Классификатор логов ТМ - из файла';$('#im-ds').innerHTML=SRC_OPTS();$('#im-ds').value='ds:tm_logs_credit_2026_10';srcHint('im-ds','im-src-link');$('#im-dom').innerHTML=MY_DOMAINS.map(d=>`<option>${esc(d)}</option>`).join('');renderImProcs();openModal('m-import');}
function doImport(){fClear(['im-name','im-procs']);let bad=false;if(!$('#im-name').value.trim()){fErr('im-name','Введите значение');bad=true;}else if(CLS.some(c=>c.dom===$('#im-dom').value&&norm(c.name)===norm($('#im-name').value))){fErr('im-name','Значение уже используется');bad=true;}if(!IMC.procs.size){fErr('im-procs','Выберите хотя бы один процесс');bad=true;}if(bad)return;const src=parseSrc($('#im-ds').value);const c={id:NEXT_CLS++,name:$('#im-name').value.trim()||'Классификатор из файла',src,ds:srcDs(src),procs:[...IMC.procs],appr:0,approved:false,last:null,by:ME,upd:TODAY,dom:$('#im-dom').value};CLS.unshift(c);RULES[c.id]=[R(1,6,100,'app_user_name','содержит','СберКредит'),R(1,6,100,'WindowTitle','содержит','Заявка'),R(2,7,110,'WindowTitle','содержит','Кредитное решение')];VERS[c.id]=[];closeModal('m-import');openCard(c.id);toast('Классификатор загружен из файла: 2 правила, 3 условия');}
function openImportRules(){$('#ir-clear').checked=false;irChanged();openModal('m-import-rules');}
function irChanged(){const c=$('#ir-clear').checked;const b=$('#ir-ok');b.textContent=c?'Очистить и импортировать':'Импортировать';b.classList.toggle('danger',c);b.classList.toggle('primary',!c);}
function doImportRules(){const clear=$('#ir-clear').checked;if(!ST.edit)startEdit(true);const a=clsOps(ST.c)[0]||1;const file=[R(1,a,100,'WindowTitle','содержит','Сверка'),R(1,a,100,'app_user_name','содержит','MS Excel'),{...R(2,'',110,'WindowTitle','содержит','Реестр'),opText:'Сверка платежей ДЗО'}];
  if(clear){ST.rows=clone(file);ST.newNos=new Set(file.map(r=>r.no));}else{const base=nextNo()-1;file.forEach(r=>{const x={...clone(r),no:r.no+base};ST.rows.push(x);ST.newNos.add(x.no);});}
  closeModal('m-import-rules');renderCard();toast(clear?'Таблица очищена, из файла загружено 2 правила':'Из файла добавлено правил: 2 - сохраните изменения');}

renderHome();

